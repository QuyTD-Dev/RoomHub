@model IEnumerable<Application.DTOs.RoomPosts.RoomListViewModel>
@{
    ViewData["Title"] = "Quản lý Bài đăng";

    // [ĐÃ SỬA]: Cập nhật lại các biến thống kê theo yêu cầu (Chỉ giữ Tổng, Trống, Đã cho thuê)
    int totalPosts = Model?.Count() ?? 0;
    int availableRooms = Model?.Count(p => p.Status == Domain.Enums.RoomStatus.Available) ?? 0;
    int occupiedRooms = Model?.Count(p => p.Status == Domain.Enums.RoomStatus.Occupied) ?? 0;
}

<div class="max-w-[1200px] mx-auto px-4 py-8 pb-24">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">dynamic_feed</span>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Quản lý Bài đăng</h1>
                <p class="text-sm text-gray-500 mt-1">Theo dõi, chỉnh sửa và quản lý trạng thái các bài đăng phòng của bạn.</p>
            </div>
        </div>
        <a asp-action="Create" class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-md shadow-orange-500/20 transition-all flex items-center gap-2 shrink-0">
            <span class="material-symbols-outlined text-[20px]">add_circle</span> Đăng bài mới
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center relative overflow-hidden">
            <div class="absolute -right-4 -bottom-4 opacity-5"><span class="material-symbols-outlined text-9xl">maps_home_work</span></div>
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Tổng bài đăng</p>
            <h3 class="text-4xl font-black text-gray-900">@totalPosts</h3>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center relative overflow-hidden">
            <div class="absolute -right-4 -bottom-4 opacity-10"><span class="material-symbols-outlined text-9xl text-green-500">door_open</span></div>
            <p class="text-xs font-bold text-green-500 uppercase tracking-wider mb-1">Phòng trống</p>
            <h3 class="text-4xl font-black text-green-600">@availableRooms</h3>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center relative overflow-hidden">
            <div class="absolute -right-4 -bottom-4 opacity-10"><span class="material-symbols-outlined text-9xl text-orange-500">vpn_key</span></div>
            <p class="text-xs font-bold text-orange-500 uppercase tracking-wider mb-1">Đã cho thuê</p>
            <h3 class="text-4xl font-black text-orange-600">@occupiedRooms</h3>
        </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="relative w-full md:w-96">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
            <input type="text" id="searchInput" placeholder="Tìm theo tiêu đề hoặc mã phòng..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all text-sm">
        </div>
        <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto hide-scrollbar" id="filterContainer">
            <span class="text-sm font-medium text-gray-500 mr-2 whitespace-nowrap">Trạng thái:</span>
            <button class="filter-btn active px-4 py-1.5 bg-slate-800 text-white rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-filter="all">Tất cả</button>
            <button class="filter-btn px-4 py-1.5 bg-gray-50 text-gray-600 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-filter="Available">Phòng trống</button>
            <button class="filter-btn px-4 py-1.5 bg-gray-50 text-gray-600 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-filter="Occupied">Đã cho thuê</button>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="roomGrid">
            @foreach (var item in Model)
            {
                var imageUrl = !string.IsNullOrEmpty(item.MainPhotoUrl) ? item.MainPhotoUrl : "https://placehold.co/600x400?text=Chua+co+anh";
                
                var badgeClass = item.Status switch
                {
                    Domain.Enums.RoomStatus.Active => "bg-green-100 text-green-700 border border-green-200",
                    Domain.Enums.RoomStatus.Hidden => "bg-gray-100 text-gray-600 border border-gray-200",
                    Domain.Enums.RoomStatus.Available => "bg-blue-100 text-blue-700 border border-blue-200",
                    Domain.Enums.RoomStatus.Occupied => "bg-orange-100 text-orange-700 border border-orange-200",
                    _ => "bg-yellow-100 text-yellow-700 border border-yellow-200"
                };

                var statusText = item.Status switch
                {
                    Domain.Enums.RoomStatus.Active => "Đang hiển thị",
                    Domain.Enums.RoomStatus.Hidden => "Đang ẩn",
                    Domain.Enums.RoomStatus.Available => "Phòng trống",
                    Domain.Enums.RoomStatus.Occupied => "Đã cho thuê",
                    _ => item.Status.ToString()
                };

                // [ĐÃ SỬA]: Gắn thêm class "room-card" và các attribute "data-status", "data-search" để JavaScript có thể đọc và lọc
                <div class="room-card bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow flex flex-col group"
                     data-status="@item.Status"
                     data-search="@item.Title.ToLower() p.@item.RoomNumber.ToLower()">
                    
                    <div class="h-48 relative overflow-hidden bg-gray-100">
                        <img alt="@item.Title" src="@imageUrl" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute top-3 left-3 px-3 py-1 rounded-full @badgeClass text-[11px] font-bold uppercase tracking-wider backdrop-blur-md bg-white/90">
                            @statusText
                        </div>
                        
                        @if (!string.IsNullOrEmpty(item.MainPhotoUrl))
                        {
                            <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm text-white p-1.5 rounded-lg flex items-center shadow-sm">
                                <span class="material-symbols-outlined text-[16px]">photo_camera</span>
                            </div>
                        }
                    </div>

                    <div class="p-5 flex-1 flex flex-col">
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-xs font-bold text-gray-400">P.@item.RoomNumber</span>
                            <span class="text-xs text-gray-400">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                        
                        <h3 class="font-bold text-gray-900 text-lg leading-snug mb-3 line-clamp-2" title="@item.Title">
                            <a asp-action="Details" asp-route-id="@item.Id" class="hover:text-orange-500 transition-colors">@item.Title</a>
                        </h3>
                        
                        <div class="flex flex-wrap gap-y-2 gap-x-4 mb-4 mt-auto">
                            <div class="flex items-center gap-1.5 text-sm text-gray-600 font-medium">
                                <span class="material-symbols-outlined text-[18px] text-gray-400">payments</span>
                                <span class="text-red-600 font-bold">@item.BasePrice.ToString("N0")đ</span>/tháng
                            </div>
                            <div class="flex items-center gap-1.5 text-sm text-gray-600">
                                <span class="material-symbols-outlined text-[18px] text-gray-400">straighten</span>
                                @(item.SurfaceArea?.ToString("0.##") ?? "--") m²
                            </div>
                        </div>

                        <div class="h-px w-full bg-gray-100 mb-4"></div>

                        <div class="flex items-center justify-between">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors flex items-center gap-1">
                                Xem chi tiết
                            </a>
                            
                            <div class="flex items-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="w-9 h-9 rounded-lg bg-orange-50 text-orange-600 hover:bg-orange-500 hover:text-white flex items-center justify-center transition-colors" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </a>
                                
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài đăng này không? Hành động này không thể hoàn tác.');">
                                    <button type="submit" class="w-9 h-9 rounded-lg bg-red-50 text-red-600 hover:bg-red-500 hover:text-white flex items-center justify-center transition-colors" title="Xóa bài">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div id="noResultMsg" class="hidden bg-white rounded-2xl border border-dashed border-gray-300 p-8 text-center mt-4">
            <span class="material-symbols-outlined text-4xl text-gray-300 mb-2">search_off</span>
            <p class="text-gray-500">Không tìm thấy phòng nào phù hợp với bộ lọc.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-3xl border border-dashed border-gray-300 p-12 flex flex-col items-center justify-center text-center mt-8">
            <div class="w-24 h-24 bg-orange-50 text-orange-500 rounded-full flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-5xl">post_add</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Chưa có bài đăng nào</h3>
            <p class="text-gray-500 max-w-md mb-8">Bạn chưa tạo bài đăng nào để tìm kiếm khách thuê. Hãy tạo bài đăng đầu tiên để tiếp cận hàng ngàn người tìm phòng!</p>
            <a asp-action="Create" class="bg-slate-900 hover:bg-slate-800 text-white px-8 py-3 rounded-xl font-bold shadow-lg transition-all flex items-center gap-2">
                <span class="material-symbols-outlined">add</span> Tạo bài đăng đầu tiên
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // [BỔ SUNG]: Script thực hiện Tìm kiếm và Lọc trực tiếp không cần load lại trang
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const filterBtns = document.querySelectorAll('.filter-btn');
            const roomCards = document.querySelectorAll('.room-card');
            const noResultMsg = document.getElementById('noResultMsg');
            let currentFilter = 'all';

            function filterRooms() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                roomCards.forEach(card => {
                    const searchData = card.getAttribute('data-search');
                    const statusData = card.getAttribute('data-status');
                    
                    // Kiểm tra xem thẻ này có khớp từ khóa VÀ khớp trạng thái không
                    const matchesSearch = searchData.includes(searchTerm);
                    const matchesFilter = currentFilter === 'all' || statusData === currentFilter;

                    if (matchesSearch && matchesFilter) {
                        card.style.display = 'flex'; // Hiển thị lại thẻ
                        visibleCount++;
                    } else {
                        card.style.display = 'none'; // Ẩn thẻ đi
                    }
                });

                // Hiển thị thông báo nếu không có kết quả nào
                if(noResultMsg) {
                    noResultMsg.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            }

            // Bắt sự kiện khi gõ phím vào ô tìm kiếm
            if (searchInput) {
                searchInput.addEventListener('input', filterRooms);
            }

            // Bắt sự kiện khi bấm nút Lọc
            filterBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    // Xóa trạng thái active của tất cả các nút
                    filterBtns.forEach(b => {
                        b.classList.remove('bg-slate-800', 'text-white');
                        b.classList.add('bg-gray-50', 'text-gray-600', 'border-gray-200');
                    });
                    
                    // Set trạng thái active cho nút vừa bấm
                    e.target.classList.remove('bg-gray-50', 'text-gray-600', 'border-gray-200');
                    e.target.classList.add('bg-slate-800', 'text-white');

                    // Lấy giá trị filter và gọi hàm lọc
                    currentFilter = e.target.getAttribute('data-filter');
                    filterRooms();
                });
            });
        });
    </script>
}