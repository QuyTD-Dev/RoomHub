@model List<Application.DTOs.Buildings.BuildingListDto>
@{
    ViewData["Title"] = "Quản lý Tòa nhà";
    int totalBuildings = Model.Count;
    int totalRooms = Model.Sum(b => b.TotalRooms);
    int occupiedRooms = Model.Sum(b => b.OccupiedRooms);
    
    // Tránh lỗi chia cho 0 nếu chưa có phòng nào
    double totalOccupancyRate = totalRooms > 0 ? Math.Round((double)occupiedRooms / totalRooms * 100, 1) : 0;
}

<div class="max-w-[1200px] mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Danh sách Tòa nhà</h1>
            <p class="text-sm text-gray-500 mt-1">Quản lý tất cả tài sản, cấu trúc phòng và người thuê của bạn</p>
        </div>
        <a href="@Url.Action("Create", "Buildings")" class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-md shadow-orange-500/20 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">add</span>
            Thêm tòa nhà mới
        </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-xs font-bold text-blue-500 mb-1 uppercase tracking-wider">Tổng số Tòa nhà</p>
                <h3 class="text-4xl font-black text-gray-900">@totalBuildings</h3>
            </div>
            <div class="w-14 h-14 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">domain</span>
            </div>
        </div>
        
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-xs font-bold text-indigo-500 mb-1 uppercase tracking-wider">Tổng số Phòng</p>
                <h3 class="text-4xl font-black text-indigo-600">@totalRooms</h3>
            </div>
            <div class="w-14 h-14 rounded-full bg-indigo-50 text-indigo-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">meeting_room</span>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-xs font-bold text-green-500 mb-1 uppercase tracking-wider">Tỉ lệ Lấp đầy</p>
                <h3 class="text-4xl font-black text-green-600">@totalOccupancyRate%</h3>
            </div>
            <div class="w-14 h-14 rounded-full bg-green-50 text-green-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">pie_chart</span>
            </div>
        </div>

    </div>
    @if (!Model.Any())
    {
        <div class="bg-white rounded-2xl border border-dashed border-gray-300 p-12 flex flex-col items-center justify-center text-center">
            <div class="w-20 h-20 bg-orange-50 text-orange-500 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-4xl">domain_disabled</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Bạn chưa có tòa nhà nào</h3>
            <p class="text-gray-500 mb-6 max-w-md">Hãy khởi tạo tòa nhà đầu tiên để bắt đầu hành trình quản lý chuyên nghiệp và nhàn hạ cùng RoomHub.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                // Tính tỉ lệ lấp đầy
                int occupancyRate = item.TotalRooms > 0 ? (int)Math.Round((double)item.OccupiedRooms / item.TotalRooms * 100) : 0;
                string progressColor = occupancyRate == 100 ? "bg-green-500" : "bg-orange-500";

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all overflow-hidden group">
                    <div class="h-48 overflow-hidden relative">
                        <img src="@(item.ThumbnailUrl ?? "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=800&q=80")" alt="@item.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-2.5 py-1 rounded-md text-xs font-bold text-gray-700 shadow-sm">
                            ID: #@item.Id
                        </div>
                    </div>
                    
                    <div class="p-5">
                        <h3 class="text-lg font-bold text-gray-900 mb-1 truncate" title="@item.Name">@item.Name</h3>
                        <p class="text-sm text-gray-500 mb-4 flex items-start gap-1 truncate">
                            <span class="material-symbols-outlined text-[16px] mt-0.5">place</span> @item.Address
                        </p>

                        <div class="grid grid-cols-3 gap-3 py-4 border-y border-gray-100">
                            <div class="text-center">
                                <p class="text-[11px] text-gray-400 font-medium mb-1">Tổng phòng</p>
                                <span class="text-base font-bold text-gray-900">@item.TotalRooms</span>
                            </div>
                            <div class="text-center border-l border-gray-100">
                                <p class="text-[11px] text-gray-400 font-medium mb-1">Đang thuê</p>
                                <span class="text-base font-bold text-blue-600">@item.OccupiedRooms</span>
                            </div>
                            <div class="text-center border-l border-gray-100">
                                <p class="text-[11px] text-gray-400 font-medium mb-1">Phòng trống</p>
                                <span class="text-base font-bold text-green-500">@item.AvailableRooms</span>
                            </div>
                        </div>

                        <div class="mt-4">
                            <div class="flex justify-between items-center mb-1.5">
                                <span class="text-xs font-semibold text-gray-500">Tỉ lệ lấp đầy</span>
                                <span class="text-xs font-bold text-gray-900">@occupancyRate%</span>
                            </div>
                            <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                                <div class="h-1.5 rounded-full @progressColor" style="width: @occupancyRate%"></div>
                            </div>
                        </div>

                        <div class="mt-5 pt-4 border-t border-gray-100 text-right">
                            <a href="@Url.Action("Details", "Buildings", new { id = item.Id })" class="inline-flex items-center gap-1.5 px-4 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-600 hover:border-orange-500 hover:text-orange-500 hover:bg-orange-50 transition-all">
                                <span class="material-symbols-outlined text-[18px]">grid_view</span> Quản lý Lưới phòng
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>