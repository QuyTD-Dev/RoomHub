<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - RoomHub</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/RoomPosts/index.css" />
    <script src="~/js/RoomPosts/index.js"></script>
</head>
<body class="bg-[#f4f4f4] dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen">

    <header class="sticky top-0 z-50 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
        <div class="max-w-[1440px] mx-auto px-4 h-16 flex items-center gap-4">
            <div class="flex items-center gap-3 flex-shrink-0">
                <button class="p-1 hover:bg-slate-100 rounded-lg">
                    <span class="material-symbols-outlined text-2xl">menu</span>
                </button>
                <a asp-controller="RoomPosts" asp-action="Index" class="text-primary text-2xl font-bold tracking-tight">RoomHub</a>
            </div>
            <button class="hidden md:flex items-center gap-2 px-3 py-1.5 border border-primary/40 bg-orange-50/50 rounded-full text-sm font-medium whitespace-nowrap">
                <span class="material-symbols-outlined text-primary text-xl">location_on</span>
                <span>Toàn quốc</span>
                <span class="material-symbols-outlined text-slate-400">expand_more</span>
            </button>
            <div class="flex-1 max-w-2xl relative group">
                <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                    <span class="material-symbols-outlined text-slate-400">search</span>
                </div>
                <input class="w-full pl-12 pr-14 py-2.5 bg-slate-100 dark:bg-slate-800 border-none rounded-full focus:ring-2 focus:ring-primary text-sm" placeholder="Tìm kiếm phòng trọ, địa điểm..." type="text" />
                <button class="absolute right-1.5 top-1/2 -translate-y-1/2 w-9 h-9 bg-primary text-white rounded-full flex items-center justify-center hover:opacity-90 transition">
                    <span class="material-symbols-outlined text-xl">search</span>
                </button>
            </div>

            <div class="flex items-center gap-2 lg:gap-4">
                <div class="flex items-center gap-1 md:gap-3 px-2 border-r border-slate-200">
                    <button class="p-2 text-slate-700 hover:text-primary transition">
                        <span class="material-symbols-outlined text-2xl">favorite</span>
                    </button>
                    <button class="p-2 text-slate-700 hover:text-primary transition">
                        <span class="material-symbols-outlined text-2xl">chat</span>
                    </button>
                    <button class="p-2 text-slate-700 hover:text-primary transition">
                        <span class="material-symbols-outlined text-2xl">notifications</span>
                    </button>
                </div>

                @* 1. NÚT POST AD: CHỈ hiển thị khi ĐÃ ĐĂNG NHẬP và KHÔNG PHẢI là Tenant *@
                @if (User.Identity.IsAuthenticated && !User.IsInRole("Tenant"))
                {
                    <a asp-controller="RoomPosts" asp-action="Create" class="bg-primary text-white px-5 py-2 rounded-lg text-sm font-bold shadow-sm hover:opacity-90 transition whitespace-nowrap inline-flex items-center justify-center">
                        Đăng tin
                    </a>
                }

                @* 2. LOGIC LOGIN / AVATAR *@
                @if (User.Identity.IsAuthenticated)
                {
                    @* Trạng thái đã đăng nhập: Hiển thị Avatar + Dropdown Menu *@
                    <div class="relative group">
                        <button class="flex items-center gap-1 p-1 hover:bg-slate-100 rounded-full cursor-pointer transition-colors" title="Hồ sơ cá nhân">
                            <div class="w-8 h-8 rounded-full bg-orange-100 border border-primary/20 flex items-center justify-center text-primary font-bold overflow-hidden">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="material-symbols-outlined text-slate-400 transition-transform duration-200 group-hover:rotate-180">expand_more</span>
                        </button>

                        @* Nội dung Dropdown (Sẽ hiện ra khi hover vào khu vực Avatar) *@
                        <div class="absolute right-0 top-full mt-1 w-56 bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-100 dark:border-slate-700 overflow-hidden opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">

                            @* Thông tin User *@
                            <div class="p-3 border-b border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
                                <p class="text-sm font-bold text-slate-800 dark:text-white truncate">@User.Identity.Name</p>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    @(User.IsInRole("Owner") ? "Property Owner" : (User.IsInRole("Tenant") ? "Tenant" : "Administrator"))
                                </p>
                            </div>

                            @* Các Menu Links (Giao diện chuẩn bị sẵn cho sau này) *@
                            <div class="p-1.5">
                                <a href="/Profile/Index" class="flex items-center gap-2 px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-primary rounded-lg transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">person</span>
                                    Trang cá nhân
                                </a>
                                @if (!User.IsInRole("Tenant"))
                                {
                                    <a asp-controller="RoomPosts" asp-action="MyPosts" class="flex items-center gap-2 px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-primary rounded-lg transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">list</span>
                                        Quản lý bài đăng
                                    </a>
                                }
                                <a href="#" class="flex items-center gap-2 px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-primary rounded-lg transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">dashboard</span>
                                    Quản lý hệ thống
                                </a>
                            </div>

                            @* Nút Đăng xuất *@
                            <div class="p-1.5 border-t border-slate-100 dark:border-slate-700">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors text-left">
                                        <span class="material-symbols-outlined text-[20px]">logout</span>
                                        Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @* Trạng thái chưa đăng nhập: Hiển thị nút Login *@
                    <a asp-controller="Auth" asp-action="Login" class="hidden sm:block text-sm font-semibold px-4 py-2 rounded-lg border border-slate-200 hover:bg-slate-50 transition cursor-pointer inline-flex items-center justify-center text-slate-700">
                        Đăng nhập
                    </a>
                }
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 pt-16 mt-12">
        <div class="max-w-[1200px] mx-auto px-4 pb-12">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
                <!-- Branding & Contact -->
                <div class="space-y-6 lg:col-span-1">
                    <a href="/" class="block">
                        <span class="text-3xl font-black bg-gradient-to-r from-primary to-orange-500 bg-clip-text text-transparent">RoomHub</span>
                    </a>
                    <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                        Nền tảng tìm kiếm và cho thuê phòng trọ, căn hộ, nhà nguyên căn hàng đầu Việt Nam. Nhanh chóng, an toàn và tiện lợi.
                    </p>
                    <div class="space-y-3 pt-2">
                        <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-xl">location_on</span>
                            <span>Tòa nhà UOA, Số 6 Tân Trào, Quận 7, TP.HCM</span>
                        </p>
                        <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-xl">call</span>
                            <span class="font-semibold">1900 1234</span>
                        </p>
                        <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-xl">mail</span>
                            <span>contact@roomhub.vn</span>
                        </p>
                    </div>
                </div>

                <!-- Về RoomHub -->
                <div class="space-y-6">
                    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Về RoomHub</h4>
                    <nav class="flex flex-col gap-3">
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Giới thiệu
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Quy chế hoạt động
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Chính sách bảo mật
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Giải quyết tranh chấp
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Tuyển dụng
                        </a>
                    </nav>
                </div>

                <!-- Khách hàng -->
                <div class="space-y-6">
                    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Hỗ trợ khách hàng</h4>
                    <nav class="flex flex-col gap-3">
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Trung tâm trợ giúp
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Hướng dẫn đăng tin
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Bảng giá dịch vụ
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Đóng góp ý kiến
                        </a>
                        <a href="#" class="text-sm text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></span> Cảnh báo lừa đảo
                        </a>
                    </nav>
                </div>

                <!-- Tải App & Social -->
                <div class="space-y-6">
                    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Tải ứng dụng</h4>
                    <div class="flex gap-3 items-center">
                        <div class="bg-white dark:bg-slate-800 p-2 rounded-xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-200 dark:border-slate-700">
                            <span class="material-symbols-outlined text-[60px] text-slate-800 dark:text-slate-200 block leading-none">qr_code_2</span>
                        </div>
                        <div class="flex flex-col gap-2 justify-center">
                            <a href="#" class="hover:-translate-y-0.5 hover:shadow-md transition-all block bg-slate-900 dark:bg-white rounded-lg px-3 py-1.5 flex items-center gap-2">
                                <span class="material-symbols-outlined text-white dark:text-slate-900 text-[20px]">apple</span>
                                <div class="text-left leading-none">
                                    <span class="text-[9px] text-slate-300 dark:text-slate-600 block">Download on the</span>
                                    <span class="text-xs text-white dark:text-slate-900 font-semibold block">App Store</span>
                                </div>
                            </a>
                            <a href="#" class="hover:-translate-y-0.5 hover:shadow-md transition-all block bg-slate-900 dark:bg-white rounded-lg px-3 py-1.5 flex items-center gap-2">
                                <span class="material-symbols-outlined text-white dark:text-slate-900 text-[20px]">shop</span>
                                <div class="text-left leading-none">
                                    <span class="text-[9px] text-slate-300 dark:text-slate-600 block">GET IT ON</span>
                                    <span class="text-xs text-white dark:text-slate-900 font-semibold block">Google Play</span>
                                </div>
                            </a>
                        </div>
                    </div>

                    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white pt-2">Kết nối với chúng tôi</h4>
                    <div class="flex gap-3">
                        <a href="#" class="w-9 h-9 rounded-full bg-[#1877F2] text-white flex items-center justify-center hover:-translate-y-1 hover:shadow-lg transition-all">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
                        </a>
                        <a href="#" class="w-9 h-9 rounded-full bg-[#FF0000] text-white flex items-center justify-center hover:-translate-y-1 hover:shadow-lg transition-all">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>
                        </a>
                        <a href="#" class="w-9 h-9 rounded-full bg-[#E1306C] text-white flex items-center justify-center hover:-translate-y-1 hover:shadow-lg transition-all">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Footer -->
        <div class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-6 mt-6">
            <div class="max-w-[1200px] mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="text-xs text-slate-500 dark:text-slate-400 space-y-1.5 text-center md:text-left">
                    <p class="font-bold text-slate-700 dark:text-slate-300 text-[13px] uppercase tracking-wide">Công ty Cổ phần Công nghệ RoomHub</p>
                    <p>Mã số doanh nghiệp: 0312120782 do Sở Kế hoạch và Đầu tư TP.HCM cấp ngày 11/01/2013</p>
                    <p>Giấy phép thiết lập MXH số 10/GP-BTTTT do Bộ Thông tin và Truyền thông cấp ngày 10/01/2025</p>
                    <p class="pt-2 text-[11px]">&copy; @DateTime.Now.Year RoomHub. All rights reserved.</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="h-10 w-auto bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 flex items-center justify-center cursor-pointer hover:bg-slate-200 dark:hover:bg-slate-700 transition">
                        <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-base">verified</span>
                            Đã đăng ký BCT
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 h-16 flex items-center justify-around px-4 z-50">
        <button class="flex flex-col items-center gap-0.5 text-primary">
            <span class="material-symbols-outlined">home</span>
            <span class="text-[10px] font-medium">Trang chủ</span>
        </button>
        <button class="flex flex-col items-center gap-0.5 text-slate-400">
            <span class="material-symbols-outlined">search</span>
            <span class="text-[10px] font-medium">Khám phá</span>
        </button>
        <button class="flex flex-col items-center gap-0.5 text-slate-400">
            <span class="material-symbols-outlined">add_circle</span>
            <span class="text-[10px] font-medium">Đăng tin</span>
        </button>
        <button class="flex flex-col items-center gap-0.5 text-slate-400">
            <span class="material-symbols-outlined">favorite</span>
            <span class="text-[10px] font-medium">Đã lưu</span>
        </button>
        <a href="/Profile/Index" class="flex flex-col items-center gap-0.5 text-slate-400">
            <span class="material-symbols-outlined">account_circle</span>
            <span class="text-[10px] font-medium">Cá nhân</span>
        </a>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>