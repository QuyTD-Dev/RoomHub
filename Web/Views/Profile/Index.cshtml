@model Application.DTOs.Profile.ProfileDto
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var initial = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "U";
    var hasAvatar = !string.IsNullOrEmpty(Model.AvatarUrl) && !Model.AvatarUrl.Contains("default-avatar");
}

<div class="max-w-[1200px] mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-6">

        
        <div class="w-full lg:w-64 flex-shrink-0">
            <partial name="_Sidebar" />
        </div>

        
        <div class="flex-1 min-w-0 space-y-5">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl shadow-sm">
                    <span class="material-symbols-outlined text-emerald-500">check_circle</span>
                    <p class="font-medium text-sm">@TempData["SuccessMessage"]</p>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl shadow-sm">
                    <span class="material-symbols-outlined text-red-500">error</span>
                    <p class="font-medium text-sm">@TempData["ErrorMessage"]</p>
                </div>
            }

            
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
                
                <div class="h-36 bg-gradient-to-br from-primary via-orange-400 to-amber-300 relative">
                    <div class="absolute inset-0 opacity-10"
                         style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')">
                    </div>
                    <a href="/Profile/Edit"
                       class="absolute top-4 right-4 flex items-center gap-1.5 bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition">
                        <span class="material-symbols-outlined text-[16px]">edit</span>
                        Chỉnh sửa
                    </a>
                </div>

                <div class="px-6 sm:px-8 pb-8">
                    
                    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between -mt-14 mb-6 gap-3">
                        <div class="flex items-end gap-4">
                            <div class="relative">
                                @if (hasAvatar)
                                {
                                    <img src="@Model.AvatarUrl" alt="Avatar"
                                         class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl border-4 border-white dark:border-slate-800 shadow-lg object-cover bg-white">
                                }
                                else
                                {
                                    <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl border-4 border-white dark:border-slate-800 shadow-lg bg-gradient-to-br from-primary to-orange-400 flex items-center justify-center">
                                        <span class="text-4xl font-black text-white">@initial</span>
                                    </div>
                                }
                                @if (Model.IsVerified)
                                {
                                    <div class="absolute -bottom-1.5 -right-1.5 w-7 h-7 bg-emerald-500 rounded-full border-2 border-white dark:border-slate-800 flex items-center justify-center" title="Tài khoản đã xác minh">
                                        <span class="material-symbols-outlined text-white text-[14px]">verified</span>
                                    </div>
                                }
                            </div>
                            <div class="pb-1">
                                <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white leading-tight">@Model.FullName</h1>
                                <p class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1 mt-0.5">
                                    <span class="material-symbols-outlined text-[14px]">mail</span>
                                    @Model.Email
                                </p>
                            </div>
                        </div>
                    </div>

                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                        <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-slate-700/40 rounded-xl">
                            <div class="w-9 h-9 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-500 flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-[18px]">call</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Số điện thoại</p>
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 truncate">
                                    @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-slate-700/40 rounded-xl">
                            <div class="w-9 h-9 rounded-lg bg-green-100 dark:bg-green-900/40 text-green-500 flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-[18px]">location_on</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Địa chỉ</p>
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                                    @(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật" : Model.Address)
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-slate-700/40 rounded-xl">
                            <div class="w-9 h-9 rounded-lg bg-purple-100 dark:bg-purple-900/40 text-purple-500 flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Ngày sinh</p>
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                                    @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-slate-700/40 rounded-xl">
                            <div class="w-9 h-9 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-500 flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-[18px]">schedule</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Tham gia từ</p>
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                                    @Model.CreatedAt.ToString("dd/MM/yyyy")
                                </p>
                            </div>
                        </div>
                    </div>

                    
                    <div>
                        <h2 class="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">Thống kê hoạt động</h2>
                        <div class="grid grid-cols-2 gap-4">
                            <a href="/Profile/MySavedRooms"
                               class="group flex items-center gap-3 p-4 bg-gradient-to-br from-red-50 to-rose-50 dark:from-red-900/20 dark:to-rose-900/10 border border-red-100 dark:border-red-800/40 rounded-xl hover:shadow-md transition-all hover:-translate-y-0.5">
                                <div class="w-12 h-12 rounded-xl bg-red-100 dark:bg-red-900/30 text-red-500 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined">favorite</span>
                                </div>
                                <div>
                                    <h3 class="text-2xl font-black text-slate-800 dark:text-white">@Model.TotalFavoriteRooms</h3>
                                    <p class="text-xs font-medium text-slate-500">Phòng đã lưu</p>
                                </div>
                            </a>
                            <div class="flex items-center gap-3 p-4 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/10 border border-blue-100 dark:border-blue-800/40 rounded-xl">
                                <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/30 text-blue-500 flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-outlined">post_add</span>
                                </div>
                                <div>
                                    <h3 class="text-2xl font-black text-slate-800 dark:text-white">@Model.TotalPostedRooms</h3>
                                    <p class="text-xs font-medium text-slate-500">Tin đã đăng</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
