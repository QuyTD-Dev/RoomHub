@using Domain.Enums
@model Application.DTOs.RoomPosts.EditRoomViewModel


    <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-8">
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 md:p-8">
            <div class="flex items-center gap-3 mb-8 pb-4 border-b border-slate-100 dark:border-slate-800">
                <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-500/10 flex items-center justify-center text-blue-600">
                    <span class="material-symbols-outlined text-3xl">edit_document</span>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Chỉnh sửa tin đăng</h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Cập nhật thông tin cho <strong>@Model.Title</strong>.</p>
                </div>
            </div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400"></div>

                <!-- Basic Details -->
                <div class="space-y-4">
                    <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200 border-b border-slate-100 dark:border-slate-700 pb-2">Thông tin cơ bản</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="md:col-span-2">
                            <label asp-for="Title" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="Title" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition" placeholder="VD: Phòng đẹp có ban công, gần trung tâm" />
                            <span asp-validation-for="Title" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="RoomNumber" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="RoomNumber" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition" />
                            <span asp-validation-for="RoomNumber" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        @{
                            var buildingGroupsEdit = Model.AvailableFloors?
                                .GroupBy(f => f.Building)
                                .ToList();
                        }

                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Toà nhà</label>
                            <select id="buildingSelect" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition">
                                <option value="">-- Chọn toà nhà --</option>
                                @if (buildingGroupsEdit != null)
                                {
                                    foreach (var group in buildingGroupsEdit)
                                    {
                                        <option value="@group.Key.Id">
                                            @group.Key.Name — @group.Key.Address, @group.Key.Ward, @group.Key.District, @group.Key.City
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="md:col-span-2 bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 rounded-xl px-5 py-4 hidden" id="buildingInfoCard">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-primary mt-0.5">apartment</span>
                                <div class="space-y-1 text-sm text-slate-700 dark:text-slate-300">
                                    <p><span class="font-semibold">Toà nhà:</span> <span id="infoName"></span></p>
                                    <p><span class="font-semibold">Địa chỉ:</span> <span id="infoAddress"></span></p>
                                    <p><span class="font-semibold">Phường/Xã:</span> <span id="infoWard"></span></p>
                                    <p><span class="font-semibold">Quận/Huyện:</span> <span id="infoDistrict"></span></p>
                                    <p><span class="font-semibold">Thành phố/Tỉnh:</span> <span id="infoCity"></span></p>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label asp-for="FloorId" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="FloorId" id="floorSelect" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition">
                                <option value="">-- Chọn toà nhà trước --</option>
                                @if(Model.AvailableFloors != null)
                                {
                                    foreach(var floor in Model.AvailableFloors)
                                    {
                                        <option value="@floor.Id" data-building="@floor.Building.Id"
                                                data-name="@floor.Building.Name"
                                                data-address="@floor.Building.Address"
                                                data-ward="@floor.Building.Ward"
                                                data-district="@floor.Building.District"
                                                data-city="@floor.Building.City"
                                                style="display:none">
                                            Tầng @floor.FloorNumber
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="FloorId" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="RoomType" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="RoomType" asp-items="Html.GetEnumSelectList<RoomType>()" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition"></select>
                            <span asp-validation-for="RoomType" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Status" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition"></select>
                            <span asp-validation-for="Status" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Pricing & Dimensions -->
                <div class="space-y-4 pt-4">
                    <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200 border-b border-slate-100 dark:border-slate-700 pb-2">Giá & Diện tích</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label asp-for="BasePrice" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <div class="relative">
                                <input asp-for="BasePrice" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 pl-4 pr-10 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition" />
                                <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-500">
                                    ₫
                                </div>
                            </div>
                            <span asp-validation-for="BasePrice" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="SurfaceArea" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <div class="relative">
                                <input asp-for="SurfaceArea" type="number" step="0.1" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 pl-4 pr-10 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition" />
                                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-500">
                                    m²
                                </div>
                            </div>
                            <span asp-validation-for="SurfaceArea" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="MaxCapacity" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                            <div class="relative">
                                <input asp-for="MaxCapacity" type="number" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 pl-4 pr-10 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition" />
                                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-500">
                                    <span class="material-symbols-outlined text-xl">group</span>
                                </div>
                            </div>
                            <span asp-validation-for="MaxCapacity" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="space-y-4 pt-4">
                    <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200 border-b border-slate-100 dark:border-slate-700 pb-2">Mô tả</h3>
                    <div>
                        <textarea asp-for="Description" rows="4" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition" placeholder="Mô tả chi tiết về phòng..."></textarea>
                        <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>

                <!-- Photos Section -->
                <div class="space-y-4 pt-4">
                    <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200 border-b border-slate-100 dark:border-slate-700 pb-2">Hình ảnh phòng</h3>
                    
                    @if (Model.ExistingPhotos != null && Model.ExistingPhotos.Any())
                    {
                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Hình ảnh hiện tại</label>
                            <p class="text-xs text-slate-500 mb-3">Chọn vào ô bên dưới ảnh để xóa.</p>
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                                @foreach (var photo in Model.ExistingPhotos)
                                {
                                    <div class="relative group rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700">
                                        <img src="@photo.Url" alt="Room Photo" class="w-full h-32 object-cover" />
                                        @if (photo.IsMain)
                                        {
                                            <div class="absolute top-2 left-2 bg-primary text-white text-[10px] font-bold px-2 py-1 rounded">ẢNH CHÍNH</div>
                                        }
                                        <div class="p-2 bg-slate-50 dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700">
                                            <label class="flex items-center gap-2 cursor-pointer">
                                                <input type="checkbox" name="DeletePhotoIds" value="@photo.Id" class="w-4 h-4 rounded border-slate-300 text-red-500 focus:ring-red-500 dark:border-slate-600 dark:bg-slate-700" />
                                                <span class="text-xs text-slate-700 dark:text-slate-300">Xóa</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div>
                        <label asp-for="NewPhotos" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"></label>
                        <input type="file" asp-for="NewPhotos" multiple accept="image/*" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-primary transition" />
                        <span asp-validation-for="NewPhotos" class="text-xs text-red-500 mt-1 block"></span>
                        <p class="text-xs text-slate-500 mt-1">Bạn có thể chọn thêm nhiều ảnh mới để tải lên.</p>
                    </div>
                </div>

                <!-- Amenities -->
                <div class="space-y-4 pt-4">
                    <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200 border-b border-slate-100 dark:border-slate-700 pb-2">Tiện ích & Tính năng</h3>
                    <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-5 border border-slate-100 dark:border-slate-700">
                        <label class="flex items-center cursor-pointer mb-6 pb-4 border-b border-slate-200 dark:border-slate-700">
                            <div class="relative">
                                <input type="checkbox" asp-for="IsFurnished" class="sr-only peer">
                                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-primary"></div>
                            </div>
                            <span class="ml-3 text-sm font-bold text-slate-800 dark:text-slate-200">Đã có đủ nội thất?</span>
                        </label>

                        @if (Model.AvailableAmenities != null && Model.AvailableAmenities.Any())
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                @foreach (var amenity in Model.AvailableAmenities)
                                {
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input type="checkbox" name="SelectedAmenityIds" value="@amenity.Id" id="amenity_@amenity.Id"
                                               @(Model.SelectedAmenityIds.Contains(amenity.Id) ? "checked" : "") 
                                               class="w-5 h-5 rounded border-slate-300 text-primary focus:ring-primary dark:border-slate-600 dark:bg-slate-700" />
                                        <span class="text-sm text-slate-700 dark:text-slate-300 group-hover:text-primary transition flex items-center gap-2">
                                            @if (!string.IsNullOrEmpty(amenity.IconUrl))
                                            {
                                                <i class="@amenity.IconUrl text-slate-400 group-hover:text-primary"></i>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined text-[18px] text-slate-400 group-hover:text-primary">check_box_outline_blank</span>
                                            }
                                            @amenity.Name
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-slate-500 text-sm italic">Không có thêm tiện ích nào để chọn.</div>
                        }
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-6 mt-6 border-t border-slate-100 dark:border-slate-800">
                    <a asp-action="Index" class="px-6 py-2.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-50 dark:hover:bg-slate-800 transition">Hủy</a>
                    <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary text-white font-bold hover:opacity-90 transition flex items-center gap-2 shadow-sm">
                        Lưu thay đổi <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
        <script>
            (function () {
                const buildingSelect = document.getElementById('buildingSelect');
                const floorSelect = document.getElementById('floorSelect');
                const infoCard = document.getElementById('buildingInfoCard');
                const allFloorOptions = Array.from(floorSelect.querySelectorAll('option[data-building]'));

                function filterFloors(buildingId) {
                    floorSelect.value = '';
                    allFloorOptions.forEach(opt => {
                        const show = !buildingId || opt.dataset.building === buildingId;
                        opt.style.display = show ? '' : 'none';
                        if (!show && opt.selected) opt.selected = false;
                    });

                    const placeholder = floorSelect.querySelector('option[value=""]');
                    if (placeholder) {
                        placeholder.textContent = buildingId ? '-- Chọn tầng --' : '-- Chọn toà nhà trước --';
                    }

                    if (buildingId) {
                        const sample = allFloorOptions.find(o => o.dataset.building === buildingId);
                        if (sample) {
                            document.getElementById('infoName').textContent = sample.dataset.name;
                            document.getElementById('infoAddress').textContent = sample.dataset.address;
                            document.getElementById('infoWard').textContent = sample.dataset.ward;
                            document.getElementById('infoDistrict').textContent = sample.dataset.district;
                            document.getElementById('infoCity').textContent = sample.dataset.city;
                        }
                        infoCard.classList.remove('hidden');
                    } else {
                        infoCard.classList.add('hidden');
                    }
                }

                buildingSelect.addEventListener('change', function () {
                    filterFloors(this.value);
                });

                // Auto-restore building + floor based on existing FloorId value
                const selectedFloorVal = '@Model.FloorId'.toString();
                if (selectedFloorVal && selectedFloorVal !== '0') {
                    const selectedOpt = allFloorOptions.find(o => o.value === selectedFloorVal);
                    if (selectedOpt) {
                        const bId = selectedOpt.dataset.building;
                        buildingSelect.value = bId;
                        filterFloors(bId);
                        floorSelect.value = selectedFloorVal;
                    }
                }
            })();
        </script>
    }

