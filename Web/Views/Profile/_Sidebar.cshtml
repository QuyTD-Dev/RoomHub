<div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden sticky top-24">
    <div class="p-4 border-b border-slate-200 dark:border-slate-700">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">Quản lý tài khoản</h3>
    </div>
    <div class="flex flex-col p-2">
        @{
            var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        }
        <a href="/Profile/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors @(action == "Index" ? "bg-primary/10 text-primary" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50")">
            <span class="material-symbols-outlined text-[20px]">person</span>
            Tổng quan
        </a>
        <a href="/Profile/Edit" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors @(action == "Edit" ? "bg-primary/10 text-primary" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50")">
            <span class="material-symbols-outlined text-[20px]">edit</span>
            Cập nhật hồ sơ
        </a>
        <a href="/Profile/MySavedRooms" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors @(action == "MySavedRooms" ? "bg-primary/10 text-primary" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50")">
            <span class="material-symbols-outlined text-[20px] text-red-500">favorite</span>
            Phòng đã lưu
        </a>
        <a href="/Profile/ChangePassword" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors @(action == "ChangePassword" ? "bg-primary/10 text-primary" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50")">
            <span class="material-symbols-outlined text-[20px]">lock</span>
            Đổi mật khẩu
        </a>
        
        <div class="h-px bg-slate-200 dark:bg-slate-700 my-2"></div>
        
        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors text-left">
                <span class="material-symbols-outlined text-[20px]">logout</span>
                Đăng xuất
            </button>
        </form>
    </div>
</div>
