@model Domain.Entities.Building
@using Domain.Enums
@{
    ViewData["Title"] = "Lưới phòng " + Model.Name;
}

<div class="max-w-[1200px] mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-6">
        <a href="@Url.Action("Index")" class="p-2 bg-white rounded-full hover:bg-gray-100 shadow-sm border border-gray-200 text-gray-500 transition-all">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Quản lý Lưới phòng: @Model.Name</h1>
            <p class="text-sm text-gray-500 flex items-center gap-1 mt-1">
                <span class="material-symbols-outlined text-[16px]">place</span> @Model.Address, @Model.District, @Model.City
            </p>
        </div>
    </div>

    <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex flex-wrap gap-6 mb-8">
        <div class="flex items-center gap-2 text-sm font-medium">
            <div class="w-4 h-4 rounded bg-green-50 border border-green-200"></div> Phòng trống
        </div>
        <div class="flex items-center gap-2 text-sm font-medium">
            <div class="w-4 h-4 rounded bg-blue-50 border border-blue-200"></div> Đang thuê
        </div>
        <div class="flex items-center gap-2 text-sm font-medium">
            <div class="w-4 h-4 rounded bg-orange-50 border border-orange-200"></div> Đang bảo trì
        </div>
    </div>

    <div class="space-y-6 flex flex-col-reverse">
        @foreach (var floor in Model.Floors.OrderBy(f => f.FloorNumber))
        {
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
                <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3">
                    <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-orange-500">layers</span>
                        Tầng @floor.FloorNumber
                    </h3>
                    <span class="text-xs text-gray-400 font-medium">@floor.Rooms.Count phòng</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    @foreach (var room in floor.Rooms.OrderBy(r => r.RoomNumber))
                    {
                        // Xác định CSS dựa vào trạng thái phòng
                        string bgClass = "bg-green-50 border-green-200";
                        string titleColor = "text-green-800";
                        string statusText = "Còn trống";
                        string icon = "check_circle";

                        if (room.Status == RoomStatus.Occupied)
                        {
                            bgClass = "bg-blue-50 border-blue-200";
                            titleColor = "text-blue-800";
                            statusText = "Đang thuê";
                            icon = "person";
                        }
                        else if (room.Status == RoomStatus.UnderMaintenance) // Sửa chữ Maintenance thành UnderMaintenance
                        {
                            bgClass = "bg-orange-50 border-orange-200";
                            titleColor = "text-orange-800";
                            statusText = "Bảo trì";
                            icon = "build";
                        }

                        <div class="relative group p-4 rounded-xl border hover:shadow-md transition-all cursor-pointer @bgClass">
                            <div class="flex justify-between items-start mb-3">
                                <h4 class="text-xl font-black @titleColor">P.@room.RoomNumber</h4>
                                <span class="bg-white/60 px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider @titleColor border border-white">
                                    @statusText
                                </span>
                            </div>
                            
                            @if (room.Status == RoomStatus.Available)
                            {
                                <div class="flex items-center gap-1.5 text-sm font-semibold text-green-600 mt-4">
                                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                                    Thêm khách / Đăng tin
                                </div>
                            }
                            else
                            {
                                <p class="text-sm font-medium text-gray-700 truncate">Khách: ...</p>
                                <div class="flex items-center gap-1 text-xs text-gray-500 mt-1">
                                    <span class="material-symbols-outlined text-[14px]">phone</span> Cập nhật sau
                                </div>
                            }

                            <div class="absolute inset-0 bg-gray-900/80 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-2 backdrop-blur-sm">
                                @if (room.Status == RoomStatus.Available)
                                {
                                    <button class="bg-white text-gray-900 px-4 py-1.5 rounded font-bold text-xs hover:bg-orange-500 hover:text-white transition-colors w-3/4">Đăng lên Web</button>
                                    <button class="bg-green-500 text-white px-4 py-1.5 rounded font-bold text-xs hover:bg-green-600 transition-colors w-3/4">Thêm khách luôn</button>
                                }
                                else
                                {
                                    <button class="bg-white text-gray-900 px-4 py-1.5 rounded font-bold text-xs hover:bg-blue-500 hover:text-white transition-colors w-3/4">Xem Hợp đồng</button>
                                    <button class="bg-red-500 text-white px-4 py-1.5 rounded font-bold text-xs hover:bg-red-600 transition-colors w-3/4">Báo trả phòng</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>