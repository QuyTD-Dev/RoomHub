@model Application.DTOs.RoomPosts.RoomDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="max-w-7xl mx-auto px-4 py-6">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
        <a asp-controller="Rooms" asp-action="Index" class="hover:text-orange-500 transition">Phòng trọ</a>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-slate-700 font-medium truncate max-w-[300px]">@Model.Title</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Left Column (2/3) -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Image Gallery -->
            <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-100">
                <div class="relative">
                    <img id="mainImage" src="@Model.Photos.FirstOrDefault()"
                         alt="@Model.Title"
                         class="w-full h-[420px] object-cover" />

                    <!-- Status -->
                    @if (Model.Status == Domain.Enums.RoomStatus.Available)
                    {
                        <span class="absolute top-4 left-4 bg-emerald-500 text-white text-sm font-bold px-4 py-1.5 rounded-full shadow-md">
                            <span class="material-symbols-outlined text-sm mr-1 align-middle">check_circle</span>
                            Còn trống
                        </span>
                    }
                    else
                    {
                        <span class="absolute top-4 left-4 bg-slate-600 text-white text-sm font-bold px-4 py-1.5 rounded-full shadow-md">
                            @Model.Status
                        </span>
                    }
                </div>

                @if (Model.Photos.Count > 1)
                {
                    <div class="flex gap-2 p-3 bg-slate-50 overflow-x-auto">
                        @foreach (var photo in Model.Photos)
                        {
                            <img src="@photo" alt="Room photo"
                                 class="w-20 h-16 object-cover rounded-lg cursor-pointer border-2 border-transparent hover:border-orange-400 transition"
                                 onclick="document.getElementById('mainImage').src = this.src" />
                        }
                    </div>
                }
            </div>

            <!-- Title & Price Header -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div class="flex-1">
                        <h1 class="text-2xl font-extrabold text-slate-800 leading-snug mb-2">
                            @Model.Title
                        </h1>
                        <div class="flex items-center gap-1.5 text-slate-500 text-sm">
                            <span class="material-symbols-outlined text-orange-400 text-lg">location_on</span>
                            <span>@Model.Address</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.LocationDetails))
                        {
                            <p class="text-xs text-slate-400 ml-6 mt-0.5">@Model.LocationDetails</p>
                        }
                    </div>
                    <div class="text-right flex-shrink-0">
                        <p class="text-3xl font-extrabold text-orange-500">
                            @Model.BasePrice.ToString("#,0") <span class="text-base font-medium text-slate-400">đ/tháng</span>
                        </p>
                        @if (Model.DepositAmount.HasValue)
                        {
                            <p class="text-xs text-slate-400 mt-1">
                                Đặt cọc: <span class="font-semibold text-slate-600">@Model.DepositAmount.Value.ToString("#,0")đ</span>
                            </p>
                        }
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6 pt-6 border-t border-slate-100">
                    <div class="flex items-center gap-2.5 p-3 bg-orange-50 rounded-xl">
                        <span class="material-symbols-outlined text-orange-500">square_foot</span>
                        <div>
                            <p class="text-xs text-slate-400">Diện tích</p>
                            <p class="font-bold text-slate-700 text-sm">@(Model.SurfaceArea?.ToString("0.#") ?? "N/A") m²</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2.5 p-3 bg-blue-50 rounded-xl">
                        <span class="material-symbols-outlined text-blue-500">group</span>
                        <div>
                            <p class="text-xs text-slate-400">Sức chứa</p>
                            <p class="font-bold text-slate-700 text-sm">@Model.MaxCapacity người</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2.5 p-3 bg-purple-50 rounded-xl">
                        <span class="material-symbols-outlined text-purple-500">apartment</span>
                        <div>
                            <p class="text-xs text-slate-400">Tầng</p>
                            <p class="font-bold text-slate-700 text-sm">Tầng @Model.FloorNumber</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2.5 p-3 bg-emerald-50 rounded-xl">
                        <span class="material-symbols-outlined text-emerald-500">
                            @(Model.IsFurnished ? "check_circle" : "cancel")
                        </span>
                        <div>
                            <p class="text-xs text-slate-400">Nội thất</p>
                            <p class="font-bold text-slate-700 text-sm">@(Model.IsFurnished ? "Đầy đủ" : "Không")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-orange-400">description</span>
                    Mô tả chi tiết
                </h2>
                <div class="text-sm text-slate-600 leading-relaxed whitespace-pre-line">
                    @Model.Description
                </div>
            </div>

            <!-- Amenities -->
            @if (Model.Amenities.Any())
            {
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                    <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-orange-400">star</span>
                        Tiện ích phòng
                    </h2>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <div class="flex items-center gap-2.5 p-3 bg-slate-50 rounded-xl hover:bg-orange-50 transition">
                                <span class="material-symbols-outlined text-orange-400 text-lg">check_circle</span>
                                <span class="text-sm text-slate-700 font-medium">@amenity.Name</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Sidebar (1/3) -->
        <div class="space-y-6">

            <!-- Landlord Card -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 sticky top-24">
                <div class="flex items-center gap-4 mb-5">
                    <img src="@Model.LandlordAvatarUrl"
                         alt="@Model.LandlordName"
                         class="w-14 h-14 rounded-full object-cover border-2 border-orange-200" />
                    <div>
                        <h3 class="font-bold text-slate-800">@Model.LandlordName</h3>
                        <div class="flex items-center gap-1 text-xs text-slate-400 mt-0.5">
                            <span class="material-symbols-outlined text-sm text-emerald-500">verified</span>
                            Đã xác minh · @Model.LandlordJoinedYears năm trên RoomHub
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    @if (!string.IsNullOrEmpty(Model.LandlordPhone))
                    {
                        <a href="tel:@Model.LandlordPhone"
                           class="w-full flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white py-3 rounded-xl font-semibold text-sm transition shadow-sm">
                            <span class="material-symbols-outlined text-lg">call</span>
                            @Model.LandlordPhone
                        </a>
                    }
                    <a href="#"
                       class="w-full flex items-center justify-center gap-2 border-2 border-orange-400 text-orange-500 hover:bg-orange-50 py-3 rounded-xl font-semibold text-sm transition">
                        <span class="material-symbols-outlined text-lg">chat</span>
                        Nhắn tin cho chủ nhà
                    </a>
                    <button class="w-full flex items-center justify-center gap-2 border border-slate-200 text-slate-600 hover:bg-slate-50 py-3 rounded-xl text-sm transition">
                        <span class="material-symbols-outlined text-lg">favorite</span>
                        Lưu tin yêu thích
                    </button>
                </div>

                <!-- Price Summary -->
                <div class="mt-6 pt-5 border-t border-slate-100 space-y-3">
                    <h4 class="font-bold text-slate-700 text-sm">Chi phí ước tính</h4>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Tiền thuê</span>
                        <span class="font-semibold text-slate-700">@Model.BasePrice.ToString("#,0")đ</span>
                    </div>
                    @if (Model.DepositAmount.HasValue)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-500">Đặt cọc</span>
                            <span class="font-semibold text-slate-700">@Model.DepositAmount.Value.ToString("#,0")đ</span>
                        </div>
                    }
                    <div class="flex justify-between text-sm pt-3 border-t border-dashed border-slate-200">
                        <span class="font-bold text-slate-700">Tổng ban đầu</span>
                        <span class="font-extrabold text-orange-500 text-base">
                            @((Model.BasePrice + (Model.DepositAmount ?? 0)).ToString("#,0"))đ
                        </span>
                    </div>
                </div>
            </div>

            <!-- Room Info Summary -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <h4 class="font-bold text-slate-700 text-sm mb-4">Thông tin phòng</h4>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-slate-500">Mã phòng</span>
                        <span class="font-medium text-slate-700">@Model.RoomNumber</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Loại phòng</span>
                        <span class="font-medium text-slate-700">
                            @switch (Model.RoomType)
                            {
                                case Domain.Enums.RoomType.Single:
                                    @:Phòng đơn
                                    break;
                                case Domain.Enums.RoomType.Double:
                                    @:Phòng đôi
                                    break;
                                case Domain.Enums.RoomType.Studio:
                                    @:Studio
                                    break;
                                default:
                                    @Model.RoomType
                                    break;
                            }
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Đăng ngày</span>
                        <span class="font-medium text-slate-700">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="flex justify-between">
                            <span class="text-slate-500">Cập nhật</span>
                            <span class="font-medium text-slate-700">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
