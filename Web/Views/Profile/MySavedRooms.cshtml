@{
    ViewData["Title"] = "Phòng đã lưu";
}

<div class="max-w-[1200px] mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-6">

        
        <div class="w-full lg:w-64 flex-shrink-0">
            <partial name="_Sidebar" />
        </div>

        
        <div class="flex-1 min-w-0">
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">

                
                <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-900/30 text-red-500 flex items-center justify-center">
                                <span class="material-symbols-outlined">favorite</span>
                            </div>
                            <div>
                                <h1 class="text-lg font-bold text-slate-800 dark:text-white">Phòng đã lưu</h1>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Danh sách phòng bạn đã đánh dấu yêu thích</p>
                            </div>
                        </div>
                        <a href="/RoomPosts/Index"
                           class="hidden sm:flex items-center gap-1.5 px-4 py-2 bg-primary text-white rounded-xl text-xs font-bold hover:opacity-90 transition shadow-md shadow-primary/20">
                            <span class="material-symbols-outlined text-[16px]">search</span>
                            Tìm phòng
                        </a>
                    </div>
                </div>

                
                <div class="p-6 sm:p-8" id="savedRoomsContainer">

                    
                    <div class="flex flex-col items-center justify-center py-16 text-center" id="emptyState">
                        <div class="w-24 h-24 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center mb-5">
                            <span class="material-symbols-outlined text-slate-400 text-[48px]">favorite_border</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-700 dark:text-slate-300 mb-2">Chưa có phòng nào được lưu</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-xs mb-6 leading-relaxed">
                            Nhấn vào biểu tượng 🤍 trên các bài đăng để lưu phòng yêu thích vào đây.
                        </p>
                        <a href="/RoomPosts/Index"
                           class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary text-white rounded-xl text-sm font-bold hover:opacity-90 transition shadow-md shadow-primary/20">
                            <span class="material-symbols-outlined text-[18px]">travel_explore</span>
                            Khám phá phòng trọ ngay
                        </a>
                    </div>

                    @* TODO: Khi tính năng Phòng đã lưu được triển khai, thay thế empty state trên bằng grid danh sách phòng *@
                </div>

            </div>
        </div>

    </div>
</div>
