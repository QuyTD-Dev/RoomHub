@model Domain.Entities.Building
@using Domain.Enums
@{
    ViewData["Title"] = "Lưới phòng " + Model.Name;
    var allRooms = Model.Floors.SelectMany(f => f.Rooms).ToList();
    int totalRooms = allRooms.Count;
    int availableRooms = allRooms.Count(r => r.Status == RoomStatus.Available);
    int occupiedRooms = allRooms.Count(r => r.Status == RoomStatus.Occupied);
    int pendingRooms = allRooms.Count(r => r.Status == RoomStatus.PendingApproval);
}

<div class="max-w-[1200px] mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-6">
        <a href="@Url.Action("Index")" class="p-2 bg-white rounded-full hover:bg-gray-100 shadow-sm border border-gray-200 text-gray-500 transition-all">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Quản lý Lưới phòng: @Model.Name</h1>
            <p class="text-sm text-gray-500 flex items-center gap-1 mt-1">
                <span class="material-symbols-outlined text-[16px]">place</span> @Model.Address, @Model.District, @Model.City
            </p>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        
        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-[10px] font-bold text-gray-400 mb-1 uppercase tracking-widest">Tổng số phòng</p>
                <h3 class="text-3xl font-black text-gray-900">@totalRooms</h3>
            </div>
            <div class="w-11 h-11 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">apartment</span>
            </div>
        </div>
        
        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-[10px] font-bold text-blue-500 mb-1 uppercase tracking-widest">Đang thuê</p>
                <h3 class="text-3xl font-black text-blue-600">@occupiedRooms</h3>
            </div>
            <div class="w-11 h-11 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">vpn_key</span>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-yellow-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-[10px] font-bold text-yellow-600 mb-1 uppercase tracking-widest">Đợi phản hồi</p>
                <h3 class="text-3xl font-black text-yellow-600">@pendingRooms</h3>
            </div>
            <div class="w-11 h-11 rounded-full bg-yellow-50 text-yellow-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">schedule</span>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-green-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-[10px] font-bold text-green-500 mb-1 uppercase tracking-widest">Phòng trống</p>
                <h3 class="text-3xl font-black text-green-600">@availableRooms</h3>
            </div>
            <div class="w-11 h-11 rounded-full bg-green-50 text-green-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">meeting_room</span>
            </div>
        </div>

    </div>
    <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex flex-wrap gap-6 mb-8">
        <div class="flex items-center gap-2 text-sm font-medium">
            <div class="w-4 h-4 rounded bg-green-50 border border-green-200"></div> Phòng trống
        </div>
        <div class="flex items-center gap-2 text-sm font-medium">
            <div class="w-4 h-4 rounded bg-blue-50 border border-blue-200"></div> Đang thuê
        </div>
        <div class="flex items-center gap-2 text-sm font-medium">
            <div class="w-4 h-4 rounded bg-yellow-50 border border-yellow-200"></div> Chờ xác nhận
        </div>
        <div class="flex items-center gap-2 text-sm font-medium">
            <div class="w-4 h-4 rounded bg-orange-50 border border-orange-200"></div> Đang bảo trì
        </div>
    </div>

    <div class="space-y-6 flex flex-col-reverse">
        @foreach (var floor in Model.Floors.OrderBy(f => f.FloorNumber))
        {
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
                <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3">
                    <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-orange-500">layers</span>
                        Tầng @floor.FloorNumber
                    </h3>
                    <span class="text-xs text-gray-400 font-medium">@floor.Rooms.Count phòng</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    @foreach (var room in floor.Rooms.OrderBy(r => r.RoomNumber))
                    {
                        // Xác định CSS dựa vào trạng thái phòng
                        string bgClass = "bg-green-50 border-green-200";
                        string titleColor = "text-green-800";
                        string statusText = "Còn trống";
                        string icon = "check_circle";

                        if (room.Status == RoomStatus.Occupied)
                        {
                            bgClass = "bg-blue-50 border-blue-200";
                            titleColor = "text-blue-800";
                            statusText = "Đang thuê";
                            icon = "person";
                        }
                        else if (room.Status == RoomStatus.PendingApproval)
                        {
                            bgClass = "bg-yellow-50 border-yellow-300";
                            titleColor = "text-yellow-700";
                            statusText = "Chờ xác nhận";
                            icon = "hourglass_empty";
                        }
                        else if (room.Status == RoomStatus.UnderMaintenance || room.Status == RoomStatus.Maintenance)
                        {
                            bgClass = "bg-orange-50 border-orange-200";
                            titleColor = "text-orange-800";
                            statusText = "Bảo trì";
                            icon = "build";
                        }

                        <div class="relative group p-4 rounded-xl border hover:shadow-md transition-all cursor-pointer @bgClass">
                            <div class="flex justify-between items-start mb-3">
                                <h4 class="text-xl font-black @titleColor">P.@room.RoomNumber</h4>
                                <span class="bg-white/60 px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider @titleColor border border-white">
                                    @statusText
                                </span>
                            </div>
                            
                            @if (room.Status == RoomStatus.Available)
                            {
                                <div class="flex items-center gap-1.5 text-sm font-semibold text-green-600 mt-4">
                                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                                    Thêm khách / Đăng tin
                                </div>
                            }
                            else if (room.Status == RoomStatus.PendingApproval)
                            {
                                <p class="text-sm font-bold text-yellow-700 mt-4 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[18px] animate-pulse">sync_problem</span>
                                    Đợi khách xác nhận...
                                </p>
                            }
                            else
                            {
                                <p class="text-sm font-medium text-gray-700 truncate">Khách: ...</p>
                                <div class="flex items-center gap-1 text-xs text-gray-500 mt-1">
                                    <span class="material-symbols-outlined text-[14px]">phone</span> Cập nhật sau
                                </div>
                            }

                            <div class="absolute inset-0 bg-gray-900/80 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-2 backdrop-blur-sm">
                                @if (room.Status == RoomStatus.Available)
                                {
                                    <button onclick="openConfigModal(@room.Id, '@room.RoomNumber', @room.BasePrice, @(room.SurfaceArea?.ToString("0.##") ?? "null"), @(room.ElectricityPrice?.ToString("0.##") ?? "null"), @(room.WaterPrice?.ToString("0.##") ?? "null"), @(room.InternetPrice?.ToString("0.##") ?? "null"), @(room.GarbagePrice?.ToString("0.##") ?? "null"))"
                                            class="bg-slate-700 text-white px-4 py-1.5 rounded font-bold text-xs hover:bg-slate-600 transition-colors w-3/4 flex justify-center items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">settings</span> Cài đặt
                                    </button>
                                    <a href="/RoomPosts/Create?roomId=@room.Id" class="bg-white text-gray-900 px-4 py-1.5 rounded font-bold text-xs hover:bg-orange-500 hover:text-white transition-colors w-3/4 flex items-center justify-center">Đăng lên Web</a>
                                    <button onclick="openAddTenantModal(@room.Id, '@room.RoomNumber', @room.BasePrice)" class="bg-green-500 text-white px-4 py-1.5 rounded font-bold text-xs hover:bg-green-600 transition-colors w-3/4">Thêm khách luôn</button>
                                }
                                else if (room.Status == RoomStatus.PendingApproval)
                                {
                                    <button onclick="viewInvitation(@room.Id)" class="bg-yellow-500 text-white px-4 py-1.5 rounded font-bold text-xs hover:bg-yellow-600 transition-colors w-3/4 flex items-center justify-center gap-1"><span class="material-symbols-outlined text-[14px]">visibility</span> Xem Lời Mời</button>
                                    <button onclick="cancelInvitation(@room.Id)" class="bg-red-500 text-white px-4 py-1.5 rounded font-bold text-xs hover:bg-red-600 transition-colors w-3/4 flex items-center justify-center gap-1"><span class="material-symbols-outlined text-[14px]">cancel</span> Hủy Lời Mời</button>
                                }
                                else
                                {
                                    <button onclick="openViewContractModal(@room.Id)" class="bg-white text-gray-900 px-4 py-1.5 rounded font-bold text-xs hover:bg-blue-500 hover:text-white transition-colors w-3/4">Thông tin Khách</button>
                                    <button onclick="checkoutRoom(@room.Id, '@room.RoomNumber')" class="bg-red-500 text-white px-4 py-1.5 rounded font-bold text-xs hover:bg-red-600 transition-colors w-3/4">Báo trả phòng</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
<div id="quickConfigModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm items-center justify-center">
    <div class="bg-white rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl scale-95 opacity-0 transition-all duration-200" id="modalContent">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <div>
                <h3 class="text-xl font-bold text-gray-900">Cài đặt Phòng <span id="m-roomName" class="text-orange-500"></span></h3>
                <p class="text-xs text-gray-500 mt-1">Ghi đè giá thuê và dịch vụ riêng cho phòng này</p>
            </div>
            <button onclick="closeConfigModal()" class="text-gray-400 hover:text-gray-800 bg-white rounded-full p-1 border border-gray-200">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="p-6 space-y-6">
            <input type="hidden" id="m-roomId" />
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Giá thuê (VNĐ/Tháng)</label>
                    <input type="number" id="m-price" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:border-orange-500 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Diện tích (m²)</label>
                    <input type="number" id="m-area" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:border-orange-500 outline-none" />
                </div>
            </div>

            <div class="p-4 rounded-xl border border-blue-100 bg-blue-50/30">
                <div class="flex items-center justify-between mb-4">
                    <label class="text-sm font-bold text-gray-800 flex items-center gap-1">
                        <span class="material-symbols-outlined text-blue-600 text-[18px]">water_drop</span>
                        Bảng giá Dịch vụ
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="m-useBuildingUtils" onchange="toggleUtilities()" class="w-4 h-4 text-orange-500 rounded border-gray-300" checked />
                        <span class="text-xs font-medium text-gray-600">Dùng giá chung của Tòa nhà</span>
                    </label>
                </div>

                <div class="grid grid-cols-2 gap-4 opacity-50 pointer-events-none transition-opacity" id="m-utilGroup">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 mb-1">Giá Điện (VNĐ)</label>
                        <input type="number" id="m-elec" value="@Model.ElectricityPrice" class="w-full px-3 py-2 bg-white border border-gray-300 rounded text-sm outline-none" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 mb-1">Nước (VNĐ/Người)</label>
                        <input type="number" id="m-water" value="@Model.WaterPrice" class="w-full px-3 py-2 bg-white border border-gray-300 rounded text-sm outline-none" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 mb-1">Internet (VNĐ)</label>
                        <input type="number" id="m-internet" value="@Model.InternetPrice" class="w-full px-3 py-2 bg-white border border-gray-300 rounded text-sm outline-none" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 mb-1">Rác (VNĐ)</label>
                        <input type="number" id="m-garbage" value="@Model.GarbagePrice" class="w-full px-3 py-2 bg-white border border-gray-300 rounded text-sm outline-none" />
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4 border-t border-gray-100 flex justify-end gap-3 bg-gray-50">
            <button onclick="closeConfigModal()" class="px-5 py-2 text-sm font-medium text-gray-600 hover:bg-gray-200 rounded-lg">Hủy</button>
            <button onclick="saveRoomConfig()" id="btn-saveConfig" class="bg-orange-500 text-white px-6 py-2 rounded-lg font-bold text-sm shadow-md hover:bg-orange-600 flex items-center gap-1">
                Lưu cài đặt
            </button>
        </div>
    </div>
</div>
<div id="addTenantModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm items-center justify-center">
    <div class="bg-white rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl scale-95 opacity-0 transition-all duration-200" id="tenantModalContent">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-green-50">
            <div>
                <h3 class="text-xl font-bold text-green-800">Thêm khách vào Phòng <span id="t-roomName" class="text-green-900 font-black"></span></h3>
                <p class="text-xs text-green-600 mt-1">Khởi tạo hợp đồng và chốt chỉ số điện nước đầu kỳ</p>
            </div>
            <button onclick="closeAddTenantModal()" class="text-gray-400 hover:text-gray-800 bg-white rounded-full p-1 border border-gray-200">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="p-6">
            <input type="hidden" id="t-roomId" />
            
            <div class="grid grid-cols-2 gap-6">
                <div class="space-y-4">
                    <h4 class="font-bold text-sm text-gray-900 border-b pb-2">1. Thông tin Khách thuê</h4>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Họ và tên <span class="text-red-500">*</span></label>
                        <input type="text" id="t-name" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none focus:border-green-500" placeholder="VD: Nguyễn Văn A" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Số điện thoại <span class="text-red-500">*</span></label>
                        <input type="text" id="t-phone" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none focus:border-green-500" placeholder="VD: 0901234567" />
                        <p class="text-[10px] text-gray-500 mt-1">SĐT sẽ được dùng liên hệ khẩn cấp.</p>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Email khách thuê <span class="text-red-500">*</span></label>
                        <input type="email" id="t-email" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none focus:border-green-500" placeholder="VD: khachthue@gmail.com" />
                        <div id="t-email-msg" class="mt-1 text-[11px] font-bold"></div>
                        <p class="text-[10px] text-orange-500 mt-1 italic">Hệ thống sẽ tự nhận diện bạn là khách trên sàn hay tạo mới khách nội bộ.</p>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Số CCCD (Tùy chọn)</label>
                        <input type="text" id="t-cccd" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none focus:border-green-500" />
                    </div>
                </div>

                <div class="space-y-4">
                    <h4 class="font-bold text-sm text-gray-900 border-b pb-2">2. Hợp đồng & Chỉ số đầu kỳ</h4>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Giá thuê/tháng</label>
                            <input type="number" id="t-price" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none font-bold text-green-600" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Tiền cọc</label>
                            <input type="number" id="t-deposit" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none" value="0" />
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Ngày bắt đầu <span class="text-red-500">*</span></label>
                            <input type="date" id="t-date" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Ngày kết thúc <span class="text-red-500">*</span></label>
                            <input type="date" id="t-endDate" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg outline-none" />
                        </div>
                    </div>

                    <div class="p-3 bg-orange-50 border border-orange-100 rounded-lg mt-4">
                        <label class="block text-[11px] font-bold text-orange-800 mb-1">Số Điện đầu kỳ (Ghi trên đồng hồ)</label>
                        <input type="number" id="t-elec" class="w-full px-3 py-1.5 bg-white border border-orange-200 rounded outline-none font-bold text-center" placeholder="Nhập số..." />
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4 border-t border-gray-100 flex justify-end gap-3 bg-gray-50">
            <button onclick="closeAddTenantModal()" class="px-5 py-2 text-sm font-medium text-gray-600 hover:bg-gray-200 rounded-lg">Hủy</button>
            <button onclick="submitTenant()" id="btn-submitTenant" class="bg-green-500 text-white px-6 py-2 rounded-lg font-bold text-sm shadow-md hover:bg-green-600 flex items-center gap-1">
                <span class="material-symbols-outlined text-[18px]">how_to_reg</span> Thêm Khách Mới
            </button>
        </div>
    </div>
</div>

<div id="successModal" class="fixed inset-0 z-[80] hidden bg-gray-900/60 backdrop-blur-sm items-center justify-center">
    <div class="bg-white rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl scale-95 opacity-0 transition-all duration-200" id="successContent">
        <div class="p-6 text-center">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4 border-4 border-green-50">
                <span class="material-symbols-outlined text-4xl text-green-500">check_circle</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display" id="successTitle">Thành công!</h3>
            <p class="text-sm text-gray-500 mb-6 leading-relaxed" id="successMessage">
                Thao tác đã được thực hiện thành công.
            </p>
            <button onclick="window.location.reload()" class="w-full bg-green-500 text-white font-bold py-2.5 px-4 rounded-xl hover:bg-green-600 transition-colors shadow-md shadow-green-200 flex items-center justify-center gap-1.5 text-sm">
                Đồng ý & Tải lại
            </button>
        </div>
    </div>
</div>

<script>
    function showSuccessModal(title, message) {
        document.getElementById('successTitle').innerText = title;
        document.getElementById('successMessage').innerText = message;
        
        const sModal = document.getElementById('successModal');
        const sContent = document.getElementById('successContent');
        
        sModal.classList.remove('hidden');
        sModal.classList.add('flex');
        setTimeout(() => {
            sContent.classList.remove('scale-95', 'opacity-0');
            sContent.classList.add('scale-100', 'opacity-100');
        }, 10);
    }
</script>

<div id="viewContractModal" class="fixed inset-0 z-[60] hidden bg-gray-900/60 backdrop-blur-sm items-center justify-center">
    <div class="bg-white rounded-2xl w-full max-w-xl overflow-hidden shadow-2xl scale-95 opacity-0 transition-all duration-200" id="viewContractContent">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50">
            <div>
                <h3 class="text-xl font-bold text-blue-800 flex items-center gap-2"><span class="material-symbols-outlined">assignment_ind</span> Thông tin Khách Thuê & Hợp Đồng</h3>
                <p class="text-xs text-blue-600 mt-1">Dữ liệu chi tiết của hợp đồng đang có hiệu lực</p>
            </div>
            <button onclick="closeViewContractModal()" class="text-gray-400 hover:text-gray-800 bg-white rounded-full p-1 border border-gray-200">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="p-6" id="viewContractBody">
            <div class="flex justify-center my-8">
                <span class="material-symbols-outlined animate-spin text-4xl text-blue-500">sync</span>
            </div>
        </div>

        <div class="p-4 border-t border-gray-100 flex justify-end bg-gray-50">
            <button onclick="closeViewContractModal()" class="px-6 py-2 bg-blue-600 text-white rounded-lg font-bold text-sm shadow-md hover:bg-blue-700">Đóng</button>
        </div>
    </div>
</div>

<div id="checkoutConfirmModal" class="fixed inset-0 z-[70] hidden bg-gray-900/60 backdrop-blur-sm items-center justify-center">
    <div class="bg-white rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl scale-95 opacity-0 transition-all duration-200" id="checkoutConfirmContent">
        <div class="p-6 text-center">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-4 border-4 border-red-50">
                <span class="material-symbols-outlined text-3xl text-red-600">report_problem</span>
            </div>
            <h3 class="text-[19px] font-bold text-gray-900 mb-2 font-display">Báo Trả Phòng <span id="co-roomName" class="text-red-600"></span>?</h3>
            <p class="text-sm text-gray-500 mb-6 leading-relaxed">
                Hành động này sẽ thanh lý hợp đồng thuê hiện tại và chuyển phòng về trạng thái <strong class="text-gray-800">Còn trống</strong>. Bạn chắc chắn chứ?
            </p>
            
            <input type="hidden" id="co-roomId" />
            
            <div class="flex flex-col gap-2.5">
                <button onclick="submitCheckout()" id="btn-submitCheckout" class="w-full bg-red-600 text-white font-bold py-2.5 px-4 rounded-xl hover:bg-red-700 transition-colors shadow-md shadow-red-200 flex items-center justify-center gap-1.5 text-sm">
                    <span class="material-symbols-outlined text-[18px]">exit_to_app</span> Xác nhận Thanh Lý
                </button>
                <button onclick="closeCheckoutModal()" class="w-full bg-gray-50 text-gray-700 font-bold py-2.5 px-4 rounded-xl hover:bg-gray-100 border border-gray-200 transition-colors text-sm">
                    Hủy bỏ
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const vcModal = document.getElementById('viewContractModal');
    const vcContent = document.getElementById('viewContractContent');
    const vcBody = document.getElementById('viewContractBody');

    function openViewContractModal(roomId) {
        vcBody.innerHTML = '<div class="flex justify-center my-8"><span class="material-symbols-outlined animate-spin text-4xl text-blue-500">sync</span></div>';
        
        vcModal.classList.remove('hidden');
        vcModal.classList.add('flex');
        setTimeout(() => {
            vcContent.classList.remove('scale-95', 'opacity-0');
            vcContent.classList.add('scale-100', 'opacity-100');
        }, 10);

        fetch('/Buildings/GetContractDetails?roomId=' + roomId)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const d = data.data;
                    vcBody.innerHTML = `
                        <div class="grid grid-cols-2 gap-6">
                            <div class="space-y-4">
                                <h4 class="font-bold text-sm text-gray-900 border-b pb-2 text-blue-800 flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">person</span> Khách Thuê</h4>
                                <div><p class="text-[11px] text-gray-500 font-bold tracking-wider uppercase">Họ và tên</p><p class="font-bold text-gray-900">${d.tenantName}</p></div>
                                <div><p class="text-[11px] text-gray-500 font-bold tracking-wider uppercase">Số điện thoại</p><p class="font-medium text-gray-900">${d.tenantPhone || 'Chưa cập nhật'}</p></div>
                                <div><p class="text-[11px] text-gray-500 font-bold tracking-wider uppercase">Email</p><p class="font-medium text-gray-900">${d.tenantEmail}</p></div>
                            </div>
                            <div class="space-y-4 border-l pl-6">
                                <h4 class="font-bold text-sm text-gray-900 border-b pb-2 text-orange-800 flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">description</span> Hợp Đồng</h4>
                                <div><p class="text-[11px] text-gray-500 font-bold tracking-wider uppercase">Giá Thuê</p><p class="font-bold text-orange-600">${d.rentAmount.toLocaleString()} đ/tháng</p></div>
                                <div><p class="text-[11px] text-gray-500 font-bold tracking-wider uppercase">Tiền cọc</p><p class="font-bold text-gray-900">${d.depositAmount.toLocaleString()} đ</p></div>
                                <div><p class="text-[11px] text-gray-500 font-bold tracking-wider uppercase">Ngày bắt đầu</p><p class="font-medium text-gray-900">${d.startDate}</p></div>
                                <div><p class="text-[11px] text-gray-500 font-bold tracking-wider uppercase">Ngày kết thúc</p><p class="font-medium text-gray-900">${d.endDate}</p></div>
                            </div>
                        </div>
                    `;
                } else {
                    vcBody.innerHTML = '<div class="text-center text-red-500 font-bold py-8">' + data.message + '</div>';
                }
            })
            .catch(err => {
                vcBody.innerHTML = '<div class="text-center text-red-500 font-bold py-8">Lỗi kết nối Server!</div>';
            });
    }

    function closeViewContractModal() {
        vcContent.classList.remove('scale-100', 'opacity-100');
        vcContent.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            vcModal.classList.add('hidden');
            vcModal.classList.remove('flex');
        }, 200);
    }

    const coModal = document.getElementById('checkoutConfirmModal');
    const coContent = document.getElementById('checkoutConfirmContent');

    function checkoutRoom(roomId, roomNumber) {
        document.getElementById('co-roomId').value = roomId;
        document.getElementById('co-roomName').innerText = roomNumber;
        
        coModal.classList.remove('hidden');
        coModal.classList.add('flex');
        setTimeout(() => {
            coContent.classList.remove('scale-95', 'opacity-0');
            coContent.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeCheckoutModal() {
        coContent.classList.remove('scale-100', 'opacity-100');
        coContent.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            coModal.classList.add('hidden');
            coModal.classList.remove('flex');
        }, 200);
    }

    async function submitCheckout() {
        const btn = document.getElementById('btn-submitCheckout');
        const roomId = document.getElementById('co-roomId').value;
        
        btn.innerHTML = `<span class="material-symbols-outlined animate-spin text-[18px]">sync</span> Đang xử lý...`;
        btn.disabled = true;

        try {
            const response = await fetch('/Buildings/CheckoutRoom', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ RoomId: parseInt(roomId) })
            });

            const data = await response.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert("Lỗi: " + data.message);
                btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">exit_to_app</span> Xác nhận Thanh Lý`;
                btn.disabled = false;
            }
        } catch (err) {
            alert("Lỗi kết nối Server.");
            btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">exit_to_app</span> Xác nhận Thanh Lý`;
            btn.disabled = false;
        }
    }
</script>

<script>
    const tenantModal = document.getElementById('addTenantModal');
    const tenantModalContent = document.getElementById('tenantModalContent');

    function openAddTenantModal(id, name, price) {
        document.getElementById('t-roomId').value = id;
        document.getElementById('t-roomName').innerText = name;
        document.getElementById('t-price').value = price;
        // Tự động lấy ngày hôm nay và ngày kết thúc (6 tháng sau)
        const today = new Date();
        document.getElementById('t-date').valueAsDate = today;
        const endDay = new Date(today);
        endDay.setMonth(endDay.getMonth() + 6);
        document.getElementById('t-endDate').valueAsDate = endDay;

        tenantModal.classList.remove('hidden');
        tenantModal.classList.add('flex');
        setTimeout(() => {
            tenantModalContent.classList.remove('scale-95', 'opacity-0');
            tenantModalContent.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeAddTenantModal() {
        tenantModalContent.classList.remove('scale-100', 'opacity-100');
        tenantModalContent.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            tenantModal.classList.add('hidden');
            tenantModal.classList.remove('flex');
            document.getElementById('t-email-msg').innerHTML = ''; // reset
        }, 200);
    }

    document.getElementById('t-email').addEventListener('blur', async function() {
        const email = this.value.trim();
        const msgBox = document.getElementById('t-email-msg');
        const submitBtn = document.getElementById('btn-submitTenant');
        
        if (!email) {
            msgBox.innerHTML = '';
            submitBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">how_to_reg</span> Thêm Khách Mới`;
            return;
        }

        try {
            msgBox.innerHTML = '<span class="text-blue-500 flex items-center gap-1 mt-2 mb-1"><span class="material-symbols-outlined text-[14px] animate-spin">sync</span> Đang kiểm tra...</span>';
            const res = await fetch('/Buildings/CheckTenant?email=' + encodeURIComponent(email));
            const data = await res.json();
            if (data.exists) {
                msgBox.innerHTML = `<span class="text-green-600 flex flex-col gap-0.5 mt-2 mb-1">
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">check_circle</span> Đã tìm thấy tài khoản chính xác:</span>
                    <span class="ml-5 font-extrabold text-blue-700">Name: ${data.fullName}</span>
                    <span class="ml-5 font-bold text-gray-500 italic">Email: ${data.email}</span>
                </span>`;
                // Auto-fill Tên và SĐT
                document.getElementById('t-name').value = data.fullName;
                document.getElementById('t-phone').value = data.phone || '';
                
                submitBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">send</span> Gửi Yêu Cầu Xác Nhận`;
                submitBtn.classList.remove('bg-green-500', 'hover:bg-green-600');
                submitBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
            } else {
                msgBox.innerHTML = `<span class="text-orange-500 flex items-center gap-1 mt-2 mb-1"><span class="material-symbols-outlined text-[14px]">warning</span> Email này chưa có TK (Sẽ tạo khách vãng lai)</span>`;
                submitBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">how_to_reg</span> Thêm Khách Mới`;
                submitBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                submitBtn.classList.add('bg-green-500', 'hover:bg-green-600');
            }
        } catch(err) {
            msgBox.innerHTML = '';
        }
    });

    async function submitTenant() {
        const btn = document.getElementById('btn-submitTenant');
        
        // Lưu trạng thái ngay từ đầu trước khi text của nút bị thay đổi thành "Đang xử lý..."
        const isOnline = btn.innerHTML.includes('Gửi');
        
        // Validate cơ bản
        const phone = document.getElementById('t-phone').value;
        const name = document.getElementById('t-name').value;
        const date = document.getElementById('t-date').value;
        const endDate = document.getElementById('t-endDate').value;
        const email = document.getElementById('t-email').value;
        
        if(!phone || !name || !date || !endDate || !email) { // [CẬP NHẬT ĐIỀU KIỆN BẮT LỖI]
            alert("Vui lòng nhập đầy đủ Tên, Số điện thoại, Email, Ngày bắt đầu và Ngày kết thúc!");
            return;
        }

        btn.innerHTML = `<span class="material-symbols-outlined animate-spin text-sm">sync</span> Đang xử lý...`;
        btn.disabled = true;

        const payload = {
            RoomId: parseInt(document.getElementById('t-roomId').value),
            FullName: name,
            PhoneNumber: phone,
            Email: email, // [BỔ SUNG ĐẨY EMAIL XUỐNG SERVER]
            IdentityCard: document.getElementById('t-cccd').value,
            RentalPrice: parseFloat(document.getElementById('t-price').value) || 0,
            DepositAmount: parseFloat(document.getElementById('t-deposit').value) || 0,
            StartDate: date,
            EndDate: endDate,
            InitialElec: parseFloat(document.getElementById('t-elec').value) || 0
        };

        try {
            const response = await fetch('/Buildings/AddDirectTenant', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            
            const data = await response.json();
            if(data.success) {
                // Kiểm tra biến isOnline đã lưu ở đầu hàm thay vì check lại DOM
                if (isOnline) {
                    showSuccessModal("Đã gửi yêu cầu!", "Đã gửi thông báo xác nhận thuê phòng cho khách hàng thông qua hệ thống.");
                } else {
                    showSuccessModal("Hoàn Tất!", "Đã thêm khách vãng lai và chốt chỉ số điện đầu kỳ vào hợp đồng thành công.");
                }
            } else {
                alert("Lỗi: " + data.message);
            }
        } catch (err) {
            alert("Lỗi kết nối Server.");
        } finally {
            if(document.getElementById('t-email-msg').innerHTML.includes('Gửi')) {
                btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">send</span> Gửi Yêu Cầu Xác Nhận`;
            } else {
                btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">how_to_reg</span> Thêm Khách Mới`;
            }
            btn.disabled = false;
        }
    }

    async function viewInvitation(roomId) {
        // Tận dùng ViewContractModal để hiện thông tin lời mời
        vcBody.innerHTML = '<div class="flex justify-center my-8"><span class="material-symbols-outlined animate-spin text-4xl text-blue-500">sync</span></div>';
        
        vcModal.classList.remove('hidden');
        vcModal.classList.add('flex');
        setTimeout(() => {
            vcContent.classList.remove('scale-100', 'opacity-100');
            vcContent.classList.add('scale-100', 'opacity-100');
        }, 10);

        try {
            const res = await fetch('/Buildings/GetInvitationDetails?roomId=' + roomId);
            const data = await res.json();
            if (data.success) {
                const d = data.data;
                vcBody.innerHTML = `
                    <div class="mb-6 p-4 bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="bg-amber-100 p-2 rounded-full border border-amber-200">
                                <span class="material-symbols-outlined text-amber-600">handshake</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-amber-900 leading-tight">Yêu Cầu Chờ Xác Nhận</h4>
                                <p class="text-[11px] text-amber-700 font-medium">Hệ thống đang đợi phản hồi từ khách thuê thông qua thông báo web.</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 bg-amber-200 text-amber-800 text-[10px] font-extrabold rounded-full uppercase tracking-widest shadow-sm">PENDING</span>
                    </div>

                    <div class="grid grid-cols-2 gap-8 px-2">
                        <div class="space-y-5">
                            <h4 class="font-bold text-sm text-gray-900 border-b pb-2 flex items-center gap-2">
                                <span class="w-2 h-2 bg-blue-500 rounded-full"></span> Đối Tác Được Mời
                            </h4>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 font-bold border border-blue-200 shadow-sm">
                                    ${d.fullName.charAt(0)}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-[11px] text-gray-400 font-bold uppercase tracking-tighter">Họ và tên</p>
                                    <p class="font-extrabold text-gray-900 truncate">${d.fullName}</p>
                                </div>
                            </div>
                            <div class="pl-2 space-y-3">
                                <div class="flex items-center gap-3">
                                    <span class="material-symbols-outlined text-[18px] text-gray-400">mail</span>
                                    <span class="text-sm font-semibold text-blue-600 italic underline decoration-blue-200">${d.email || 'N/A'}</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="material-symbols-outlined text-[18px] text-gray-400">call</span>
                                    <span class="text-sm font-medium text-gray-800">${d.phone || 'Chưa cung cấp'}</span>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-5 border-l border-dashed pl-8">
                            <h4 class="font-bold text-sm text-gray-900 border-b pb-2 flex items-center gap-2">
                                <span class="w-2 h-2 bg-orange-500 rounded-full"></span> Chi Tiết Thỏa Thuận
                            </h4>
                            <div class="space-y-4">
                                <div class="bg-gray-50/50 p-2.5 rounded-xl border border-gray-100">
                                    <p class="text-[10px] text-gray-400 font-bold uppercase">Giá Thuê Đề Xuất</p>
                                    <p class="text-lg font-black text-orange-600">${d.rentalPrice.toLocaleString()} <small class="text-[10px] text-gray-400 underline uppercase">đ / tháng</small></p>
                                </div>
                                <div class="grid grid-cols-2 gap-4 ml-1">
                                    <div>
                                        <p class="text-[10px] text-gray-400 font-bold uppercase">Tiền cọc</p>
                                        <p class="text-sm font-bold text-gray-800">${d.depositAmount.toLocaleString()} đ</p>
                                    </div>
                                    <div>
                                        <p class="text-[10px] text-gray-400 font-bold uppercase">Bắt đầu từ</p>
                                        <p class="text-sm font-bold text-gray-800">${d.startDate}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                vcBody.innerHTML = `
                    <div class="text-center py-10">
                        <div class="inline-flex items-center justify-center w-16 h-16 bg-red-50 text-red-400 rounded-full mb-4">
                            <span class="material-symbols-outlined text-4xl">warning</span>
                        </div>
                        <h4 class="text-lg font-bold text-gray-900">${data.message}</h4>
                        <p class="text-sm text-gray-500 mt-1">Vui lòng thử lại sau hoặc làm mới trang.</p>
                    </div>
                `;
            }
        } catch(e) {
            vcBody.innerHTML = '<div class="text-center text-red-500 font-bold py-10 italic underline">Lỗi kết nối Server!</div>';
        }
    }

    async function cancelInvitation(roomId) {
        const result = await Swal.fire({
            title: 'Hủy lời mời này?',
            text: "Hợp đồng nháp sẽ bị xóa và phòng sẽ quay về trạng thái Trống. Lưu ý: Lời mời đã gửi tới khách sẽ không còn hiệu lực.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Đồng ý hủy',
            cancelButtonText: 'Không hủy'
        });

        if (result.isConfirmed) {
            try {
                const res = await fetch('/Buildings/CancelInvitation?roomId=' + roomId, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showSuccessModal("Đã Hủy!", "Lời mời đã được thu hồi và phòng đã trở về trạng thái Còn trống.");
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                }
            } catch(e) {
                Swal.fire('Lỗi', 'Lỗi kết nối Server', 'error');
            }
        }
    }
</script>

@section Scripts {
    <script>
        const b_elec = @Model.ElectricityPrice;
        const b_water = @Model.WaterPrice;
        const b_internet = @Model.InternetPrice;
        const b_garbage = @Model.GarbagePrice;

        const modal = document.getElementById('quickConfigModal');
        const modalContent = document.getElementById('modalContent');
        const utilGroup = document.getElementById('m-utilGroup');
        const useBuildingCheckbox = document.getElementById('m-useBuildingUtils');

        function openConfigModal(id, name, price, area, elec, water, internet, garbage) {
            document.getElementById('m-roomId').value = id;
            document.getElementById('m-roomName').innerText = name;
            document.getElementById('m-price').value = price;
            document.getElementById('m-area').value = area || '';

            // Nếu phòng có giá điện nước riêng (!= null) thì bỏ check và điền giá riêng
            if (elec !== null || water !== null) {
                useBuildingCheckbox.checked = false;
                document.getElementById('m-elec').value = elec || 0;
                document.getElementById('m-water').value = water || 0;
                document.getElementById('m-internet').value = internet || 0;
                document.getElementById('m-garbage').value = garbage || 0;
            } else {
                useBuildingCheckbox.checked = true;
                document.getElementById('m-elec').value = b_elec;
                document.getElementById('m-water').value = b_water;
                document.getElementById('m-internet').value = b_internet;
                document.getElementById('m-garbage').value = b_garbage;
            }
            
            toggleUtilities();

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeConfigModal() {
            modalContent.classList.remove('scale-100', 'opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 200);
        }

        function toggleUtilities() {
            if (useBuildingCheckbox.checked) {
                utilGroup.classList.add('opacity-50', 'pointer-events-none');
            } else {
                utilGroup.classList.remove('opacity-50', 'pointer-events-none');
            }
        }

        async function saveRoomConfig() {
            const btn = document.getElementById('btn-saveConfig');
            btn.innerHTML = `<span class="material-symbols-outlined animate-spin text-sm">sync</span> Đang lưu...`;
            btn.disabled = true;

            const payload = {
                RoomId: parseInt(document.getElementById('m-roomId').value),
                BasePrice: parseFloat(document.getElementById('m-price').value) || 0,
                SurfaceArea: parseFloat(document.getElementById('m-area').value) || null,
                UseBuildingUtilities: useBuildingCheckbox.checked,
                ElectricityPrice: parseFloat(document.getElementById('m-elec').value) || 0,
                WaterPrice: parseFloat(document.getElementById('m-water').value) || 0,
                InternetPrice: parseFloat(document.getElementById('m-internet').value) || 0,
                GarbagePrice: parseFloat(document.getElementById('m-garbage').value) || 0
            };

            try {
                const response = await fetch('/Buildings/UpdateRoomQuickConfig', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                const data = await response.json();
                if(data.success) {
                    // Hiển thị trực tiếp giá mới lên thẻ phòng nếu muốn, hoặc đơn giản là Reload lại trang
                    window.location.reload();
                } else {
                    alert("Lỗi: " + data.message);
                }
            } catch (err) {
                alert("Lỗi kết nối Server.");
            } finally {
                btn.innerHTML = `Lưu cài đặt`;
                btn.disabled = false;
            }
        }
    </script>
}