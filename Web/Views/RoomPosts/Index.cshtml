@using System.Security.Claims
@model Application.DTOs.RoomPosts.PaginatedList<Application.DTOs.RoomPosts.RoomListViewModel>
@{
    ViewData["Title"] = "Property Marketplace";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = User.IsInRole("PropertyOwner");
    var isSearching = (bool)(ViewBag.isSearching ?? false);
    var searchQuery = (string?)ViewBag.searchQuery;
    var province = (string?)ViewBag.province;
    var currentRoomType = (Domain.Enums.RoomType?)ViewBag.roomType;
    var currentMinPrice = (decimal?)ViewBag.minPrice;
    var currentMaxPrice = (decimal?)ViewBag.maxPrice;
    var currentDistrict = (string?)ViewBag.district;
    var currentSortBy = (string?)ViewBag.sortBy ?? "newest";

    string BuildFilterUrl(string? q = null, string? prov = null, string? rt = null, string? minP = null, string? maxP = null, string? dist = null, string? sort = null, bool clearRoomType = false, bool clearPrice = false, bool clearProvince = false, bool clearDistrict = false)
    {
        var qs = new List<string>();
        var qVal = q ?? searchQuery;
        if (!string.IsNullOrWhiteSpace(qVal)) qs.Add($"q={Uri.EscapeDataString(qVal)}");
        if (!clearProvince)
        {
            var provVal = prov ?? province;
            if (!string.IsNullOrWhiteSpace(provVal)) qs.Add($"province={Uri.EscapeDataString(provVal)}");
        }
        if (!clearRoomType)
        {
            var rtVal = rt ?? currentRoomType?.ToString();
            if (!string.IsNullOrWhiteSpace(rtVal)) qs.Add($"roomType={Uri.EscapeDataString(rtVal)}");
        }
        if (!clearPrice)
        {
            var minVal = minP ?? currentMinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (!string.IsNullOrWhiteSpace(minVal)) qs.Add($"minPrice={minVal}");
            var maxVal = maxP ?? currentMaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (!string.IsNullOrWhiteSpace(maxVal)) qs.Add($"maxPrice={maxVal}");
        }
        if (!clearDistrict)
        {
            var distVal = dist ?? currentDistrict;
            if (!string.IsNullOrWhiteSpace(distVal)) qs.Add($"district={Uri.EscapeDataString(distVal)}");
        }
        var sortVal = sort ?? currentSortBy;
        if (!string.IsNullOrWhiteSpace(sortVal) && sortVal != "newest") qs.Add($"sortBy={sortVal}");
        return "/RoomPosts" + (qs.Any() ? "?" + string.Join("&", qs) : "");
    }

    var sortLabel = currentSortBy switch {
        "price_asc" => "Giá tăng dần",
        "price_desc" => "Giá giảm dần",
        "area_asc" => "Diện tích tăng",
        "area_desc" => "Diện tích giảm",
        _ => "Mới nhất"
    };

    var roomTypeIcons = new[] {
        (Domain.Enums.RoomType.Apartment, "apartment", "Căn hộ"),
        (Domain.Enums.RoomType.Single, "meeting_room", "Phòng đơn"),
        (Domain.Enums.RoomType.Double, "king_bed", "Phòng đôi"),
        (Domain.Enums.RoomType.Studio, "weekend", "Studio"),
        (Domain.Enums.RoomType.WholeHouse, "home", "Nhà nguyên căn"),
        (Domain.Enums.RoomType.Shared, "group", "Phòng ghép"),
        (Domain.Enums.RoomType.Duplex, "stairs", "Duplex"),
        (Domain.Enums.RoomType.Other, "more_horiz", "Khác")
    };

    var regions = new[] { "Hồ Chí Minh", "Hà Nội", "Đà Nẵng", "Bình Dương", "Thừa Thiên Huế", "Cần Thơ", "Hải Phòng" };
}
    <main class="max-w-7xl mx-auto px-4 py-4">

        @if (isSearching)
        {
            <div class="mb-4 flex items-center justify-between bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl px-4 py-3">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="material-symbols-outlined text-primary" style="font-size:20px">search</span>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">
                        Kết quả tìm kiếm
                        @if (!string.IsNullOrWhiteSpace(searchQuery)) { <span> cho <strong class="text-primary">"@searchQuery"</strong></span> }
                        @if (!string.IsNullOrWhiteSpace(province)) { <span> tại <strong class="text-primary">@province</strong></span> }
                        @if (currentRoomType.HasValue) { <span> — <strong class="text-primary">@currentRoomType</strong></span> }
                        @if (currentMinPrice.HasValue || currentMaxPrice.HasValue)
                        {
                            <span> — Giá:
                                @if (currentMinPrice.HasValue) { <span>từ <strong>@currentMinPrice?.ToString("N0")đ</strong></span> }
                                @if (currentMaxPrice.HasValue) { <span>đến <strong>@currentMaxPrice?.ToString("N0")đ</strong></span> }
                            </span>
                        }
                        <span class="text-slate-500"> — @Model.TotalItems phòng</span>
                    </span>
                </div>
                <a href="/RoomPosts" class="text-xs font-semibold text-slate-500 hover:text-primary flex items-center gap-1 whitespace-nowrap">
                    <span class="material-symbols-outlined" style="font-size:16px">close</span> Xoá bộ lọc
                </a>
            </div>
        }

        @* ===== FILTER BAR ===== *@
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4 mb-6">
            @* Row 1: Filter buttons *@
            <div class="flex items-center gap-3 overflow-x-auto pb-3 hide-scrollbar">
                <button id="btnAdvancedFilter"
                        class="flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium whitespace-nowrap hover:border-primary hover:text-primary transition">
                    <span class="material-symbols-outlined text-lg">tune</span> Bộ lọc
                </button>

                @* Loại phòng *@
                <div class="relative" id="roomTypeDropdown">
                    <button data-dropdown="roomTypeMenu"
                            class="flex items-center gap-1 px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition @(currentRoomType.HasValue ? "bg-primary text-white" : "bg-slate-100 dark:bg-slate-800 border border-transparent hover:border-primary hover:text-primary")">
                        Loại phòng @(currentRoomType.HasValue ? $"({currentRoomType})" : "")
                        <span class="material-symbols-outlined text-xs">expand_more</span>
                    </button>
                    <div id="roomTypeMenu" class="filter-dropdown hidden fixed bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xl z-[9999] min-w-[200px] py-1">
                        @foreach (Domain.Enums.RoomType rt in Enum.GetValues(typeof(Domain.Enums.RoomType)))
                        {
                            var isActive = currentRoomType.HasValue && currentRoomType.Value == rt;
                            var displayAttr = rt.GetType().GetField(rt.ToString())?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false);
                            var displayName = (displayAttr != null && displayAttr.Length > 0) ? ((System.ComponentModel.DataAnnotations.DisplayAttribute)displayAttr[0]).Name : rt.ToString();
                            <a href="@BuildFilterUrl(rt: rt.ToString())"
                               class="block px-4 py-2.5 text-sm hover:bg-orange-50 dark:hover:bg-slate-700 transition @(isActive ? "text-primary font-bold bg-orange-50" : "text-slate-700 dark:text-slate-300")">
                                @displayName
                            </a>
                        }
                        @if (currentRoomType.HasValue)
                        {
                            <div class="border-t border-slate-100 dark:border-slate-700 mt-1 pt-1">
                                <a href="@BuildFilterUrl(clearRoomType: true)" class="block px-4 py-2 text-sm text-red-500 hover:bg-red-50 font-medium">
                                    <span class="material-symbols-outlined text-sm align-middle mr-1">close</span>Bỏ lọc loại phòng
                                </a>
                            </div>
                        }
                    </div>
                </div>

                @* Khoảng giá *@
                <div class="relative" id="priceDropdown">
                    <button data-dropdown="priceMenu"
                            class="flex items-center gap-1 px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition @(currentMinPrice.HasValue || currentMaxPrice.HasValue ? "bg-primary text-white" : "bg-slate-100 dark:bg-slate-800 border border-transparent hover:border-primary hover:text-primary")">
                        Khoảng giá @(currentMinPrice.HasValue || currentMaxPrice.HasValue ? "✓" : "")
                        <span class="material-symbols-outlined text-xs">expand_more</span>
                    </button>
                    <div id="priceMenu" class="filter-dropdown hidden fixed bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xl z-[9999] min-w-[220px] py-1">
                        <a href="@BuildFilterUrl(maxP: "3000000", clearPrice: true)" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-orange-50 transition">Dưới 3 triệu</a>
                        <a href="@BuildFilterUrl(minP: "3000000", maxP: "5000000")" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-orange-50 transition">3 - 5 triệu</a>
                        <a href="@BuildFilterUrl(minP: "5000000", maxP: "10000000")" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-orange-50 transition">5 - 10 triệu</a>
                        <a href="@BuildFilterUrl(minP: "10000000", maxP: "20000000")" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-orange-50 transition">10 - 20 triệu</a>
                        <a href="@BuildFilterUrl(minP: "20000000")" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-orange-50 transition">Trên 20 triệu</a>
                        @if (currentMinPrice.HasValue || currentMaxPrice.HasValue)
                        {
                            <div class="border-t border-slate-100 mt-1 pt-1">
                                <a href="@BuildFilterUrl(clearPrice: true)" class="block px-4 py-2 text-sm text-red-500 hover:bg-red-50 font-medium">
                                    <span class="material-symbols-outlined text-sm align-middle mr-1">close</span>Bỏ lọc giá
                                </a>
                            </div>
                        }
                    </div>
                </div>

                @* Sắp xếp *@
                <div class="relative" id="sortDropdown">
                    <button data-dropdown="sortMenu"
                            class="flex items-center gap-1 px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition @(currentSortBy != "newest" ? "bg-primary text-white" : "bg-slate-100 dark:bg-slate-800 border border-transparent hover:border-primary hover:text-primary")">
                        <span class="material-symbols-outlined text-sm">sort</span> @sortLabel
                        <span class="material-symbols-outlined text-xs">expand_more</span>
                    </button>
                    <div id="sortMenu" class="filter-dropdown hidden fixed bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xl z-[9999] min-w-[200px] py-1">
                        @{
                            var sortOptions = new[] {
                                ("newest", "Mới nhất", "schedule"),
                                ("price_asc", "Giá tăng dần", "trending_up"),
                                ("price_desc", "Giá giảm dần", "trending_down"),
                                ("area_asc", "Diện tích tăng", "open_in_full"),
                                ("area_desc", "Diện tích giảm", "close_fullscreen")
                            };
                        }
                        @foreach (var (val, label, icon) in sortOptions)
                        {
                            var isActive = currentSortBy == val;
                            <a href="@BuildFilterUrl(sort: val)"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-orange-50 transition @(isActive ? "text-primary font-bold bg-orange-50" : "text-slate-700 dark:text-slate-300")">
                                <span class="material-symbols-outlined text-sm">@icon</span> @label
                            </a>
                        }
                    </div>
                </div>

                <div class="h-6 w-px bg-slate-300 dark:bg-slate-700 mx-2"></div>
                <a href="/RoomPosts" class="text-slate-500 text-sm font-medium hover:text-primary whitespace-nowrap px-2 transition">Đặt lại</a>
            </div>

            @* Advanced filter panel *@
            <div id="advancedFilterPanel" class="hidden border-t border-slate-100 dark:border-slate-800 pt-4 mt-1">
                <form method="get" action="/RoomPosts/Index" class="flex flex-wrap items-end gap-4">
                    @if (!string.IsNullOrWhiteSpace(searchQuery)) { <input type="hidden" name="q" value="@searchQuery" /> }
                    @if (currentRoomType.HasValue) { <input type="hidden" name="roomType" value="@currentRoomType" /> }
                    @if (currentSortBy != "newest") { <input type="hidden" name="sortBy" value="@currentSortBy" /> }
                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-semibold text-slate-500">Tỉnh/Thành phố</label>
                        <input type="text" name="province" value="@province" placeholder="Ví dụ: Hồ Chí Minh"
                               class="px-3 py-2 border border-slate-200 rounded-lg text-sm w-44 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-semibold text-slate-500">Quận/Huyện</label>
                        <input type="text" name="district" value="@currentDistrict" placeholder="Ví dụ: Quận 1"
                               class="px-3 py-2 border border-slate-200 rounded-lg text-sm w-44 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-semibold text-slate-500">Giá từ (VNĐ)</label>
                        <input type="number" name="minPrice" value="@currentMinPrice" placeholder="0"
                               class="px-3 py-2 border border-slate-200 rounded-lg text-sm w-36 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-semibold text-slate-500">Giá đến (VNĐ)</label>
                        <input type="number" name="maxPrice" value="@currentMaxPrice" placeholder="99999999"
                               class="px-3 py-2 border border-slate-200 rounded-lg text-sm w-36 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition" />
                    </div>
                    <button type="submit" class="px-5 py-2 bg-primary text-white rounded-lg text-sm font-bold hover:opacity-90 transition flex items-center gap-1.5 shadow-sm">
                        <span class="material-symbols-outlined text-sm">search</span> Lọc
                    </button>
                </form>
            </div>

            @* Row 2: Region quick filters *@
            <div class="flex items-center gap-2 py-3 border-t border-slate-100 dark:border-slate-800 overflow-x-auto hide-scrollbar">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-2">Khu vực:</span>
                @foreach (var name in regions)
                {
                    var isActive = !string.IsNullOrWhiteSpace(province) && province.Contains(name, StringComparison.OrdinalIgnoreCase);
                    if (isActive)
                    {
                        <a href="@BuildFilterUrl(clearProvince: true)"
                           class="px-4 py-1.5 border-2 border-primary rounded-full text-sm whitespace-nowrap bg-primary text-white font-semibold transition flex items-center gap-1">
                            @name <span class="material-symbols-outlined text-xs">close</span>
                        </a>
                    }
                    else
                    {
                        <a href="@BuildFilterUrl(prov: name)"
                           class="px-4 py-1.5 border border-slate-200 rounded-full text-sm whitespace-nowrap hover:border-primary hover:text-primary transition">
                            @name
                        </a>
                    }
                }
            </div>

            @* Row 3: Room type icons *@
            <div class="flex items-center gap-8 py-4 border-t border-slate-100 dark:border-slate-800 justify-start overflow-x-auto hide-scrollbar">
                @foreach (var (rt, icon, label) in roomTypeIcons)
                {
                    var isActive = currentRoomType.HasValue && currentRoomType.Value == rt;
                    var url = isActive ? BuildFilterUrl(clearRoomType: true) : BuildFilterUrl(rt: rt.ToString());
                    <a href="@url" class="flex flex-col items-center gap-2 min-w-[72px] group">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center transition @(isActive ? "bg-primary text-white shadow-lg shadow-primary/30 scale-110" : "bg-slate-50 text-slate-600 group-hover:bg-orange-50 group-hover:text-primary")">
                            <span class="material-symbols-outlined text-2xl">@icon</span>
                        </div>
                        <span class="text-xs font-semibold transition @(isActive ? "text-primary" : "text-slate-600 group-hover:text-primary")">@label</span>
                    </a>
                }
            </div>
        </div>

        <div class="grid grid-cols-12 gap-6">
            <div class="col-span-12 lg:col-span-8 space-y-6">
                <section class="bg-white dark:bg-slate-900 p-4 rounded-xl shadow-sm overflow-hidden border border-slate-100">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">play_circle</span>
                            RoomHub Shorts
                        </h2>
                        <a class="text-xs font-semibold text-primary hover:underline" href="#">View all</a>
                    </div>
                    <div class="flex gap-4 overflow-x-auto hide-scrollbar pb-2">
                        <div class="flex-shrink-0 w-32 aspect-[9/16] relative rounded-lg overflow-hidden group cursor-pointer">
                            <img alt="Property Reel" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDH7EJIzPiZUExORapJEGMQJUwsxmutuQt-8QKNkwROD6SgpHB3GhI7SNmL04po7eKV8Zu5Ju0OBDYx9F2PFnFo7ZePQ_unqM16ZP3womgRq46QCn_N3i5AsrCvbahczhMf1_JrV8vlY9wVeyUm5PryxrVccFTMcdgarXirw11izYy8kyXR9BcfvUGyxIfGC3Q3MjBtzyeJQs3MhUA3frSHvh2fAyzlLQ6g2kbKBAY92DvrYakGuu0ROuAvHaGAiT4G4rZyzainAV0" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-2">
                                <span class="text-[10px] text-white font-medium">Modern Villas</span>
                            </div>
                        </div>
                        <div class="flex-shrink-0 w-32 aspect-[9/16] relative rounded-lg overflow-hidden group cursor-pointer">
                            <img alt="Property Reel" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBInMbCpI7o4moy8Fe4eUVv6OnN3NEYlPWS1iyZJ3bVA-8QBzVg29Y6hqz5NBoPEKR3jziAVYeHF2ZolJUDaTMQX9HqdPBKccyCMjKk3WoY0Iy3uncEy9FR-6JnfzwG5dMMiITG0XfK98J6hf2VPCAT_kGa1_ecxcbdZ0_QJvVDc8XpVqfOqBocdWL4kvTNT9zaPbnvyRls91Bpy2x8JrYXT9JFxVjrQ_9-kPB6hmCJDxcJfRTMMTGI_rhShoIlCPdRGSJ2VNGbV48" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-2">
                                <span class="text-[10px] text-white font-medium">Urban Penthouses</span>
                            </div>
                        </div>
                        <div class="flex-shrink-0 w-32 aspect-[9/16] relative rounded-lg overflow-hidden group cursor-pointer">
                            <img alt="Property Reel" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBu8ErIlGYBAW3i9fhNKM0PAXHeOC1aUJc15Pxmy0YuOGykZBr949oTOMZBDUdCJdiwGXYd6sjj84cBLcYJDaanDY6dIot0APfKsm29WTCJ0hvwum9yZACq_Pi_muQQmpVdpnJuD-DAWC-k5wsA9XhvzFlzs1z4tRBFEgNtJKehhr2ch953uC0YWvlVeagfMqdtbgh13U94hJsH2D6EXk2INcN9v96POAugprLZPjBPweTQvQKPdd-VnQ-f-P8a4b6pSqkDdaM2BVQ" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-2">
                                <span class="text-[10px] text-white font-medium">Studio Tours</span>
                            </div>
                        </div>
                        <div class="flex-shrink-0 w-32 aspect-[9/16] relative rounded-lg overflow-hidden group cursor-pointer">
                            <img alt="Property Reel" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCOe14usiAK02AFGf631g3-V4_IVJTLelwT-EvjXzWvcE1gpFbCoptKtHNIUv1QgV17ksxg9O6GwBfCM31wLhtgElNXggnuX9_oicJeQKU8sjqeRwtB-9xUx0zYBPezDIAZGeChiJv-40h8Miuvuxub0ueAcdfX_xskaf3vgvORRqfk_25M2V0MFu6hv5AYvyBDPUnTQ1Iszz2T1i2mQWjLX0rVFLdLit6ZDGG8wkj50H0yoM8flw6xrmx4dH8P5P_LH_6OXFqybhs" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-2">
                                <span class="text-[10px] text-white font-medium">Garden Homes</span>
                            </div>
                        </div>
                        <div class="flex-shrink-0 w-32 aspect-[9/16] relative rounded-lg overflow-hidden group cursor-pointer">
                            <img alt="Property Reel" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDG_pL7s5NmqRPQ0q9dBhGrgj4gHetI_Ik8PIMrOddtklT1OqH0wbz5BpBLISdCg3U_wPTItzDz3-NdvrKHicCvw8cDXQLXdKRsGCFiZAuGfNpQMrmoHWRc_OpdYCS-UBZmEys-oIxSX-VKs9bnZqYiY6ztpwnJz31z_wTAYnMFjWP8V6JVs6Oovo_RMHJeh7zUKeZCRqxeasoZQtJJBLiLH2P4cb0fsRm4wkPrECE3DUrfonCFtMW3Cz60ylQ9P87nCQUzD7-axlo" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-2">
                                <span class="text-[10px] text-white font-medium">Beachfront</span>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="space-y-4">
                    @if (Model != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            bool isMyPost = isOwner && item.LandlordId == currentUserId;

                        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm flex flex-col md:flex-row overflow-hidden group cursor-pointer hover:shadow-md transition border border-slate-100">
                            <div class="md:w-72 h-48 md:h-auto overflow-hidden relative">
                                <img alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" src="@(string.IsNullOrEmpty(item.MainPhotoUrl) ? "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&q=80" : item.MainPhotoUrl)" />
            
                                @if (!isMyPost && User.Identity.IsAuthenticated)
                                {
                                    <button class="btn-toggle-favorite absolute top-2 right-2 z-10 p-2 rounded-full bg-white/80 dark:bg-slate-800/80 backdrop-blur shadow hover:scale-110 transition flex items-center justify-center"
                                            data-room-id="@item.Id">
                                        <span class="material-symbols-outlined text-xl transition-colors duration-300"
                                              style="@(item.IsFavorite ? "font-variation-settings: 'FILL' 1; color: #ef4444;" : "font-variation-settings: 'FILL' 0; color: #94a3b8;")">
                                            favorite
                                        </span>
                                    </button>
                                }
                                @{
                                    var badgeClass = item.Status switch
                                    {
                                        Domain.Enums.RoomStatus.Active => "bg-success",
                                        Domain.Enums.RoomStatus.Hidden => "bg-secondary",
