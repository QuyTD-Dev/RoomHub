@model Application.DTOs.Admin.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Tổng quan hệ thống RoomHub";
    ViewData["ActiveMenu"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- ═══ Stat Cards ═══ -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
    <!-- Rooms -->
    <div class="stat-card animate-fade-in animate-delay-1">
        <div class="flex items-center justify-between mb-4">
            <div class="stat-icon" style="background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(59,130,246,0.05));">
                <span class="material-symbols-outlined" style="color: #60a5fa; font-variation-settings:'FILL' 1;">meeting_room</span>
            </div>
            <div class="glow-dot" style="background: #60a5fa;"></div>
        </div>
        <p class="text-[28px] font-extrabold text-white tracking-tight leading-none" data-count="@Model.TotalRooms">0</p>
        <p class="text-[11px] font-medium mt-1.5" style="color: rgba(148,163,184,0.6);">Tổng số phòng</p>
    </div>

    <!-- Active Contracts -->
    <div class="stat-card animate-fade-in animate-delay-2">
        <div class="flex items-center justify-between mb-4">
            <div class="stat-icon" style="background: linear-gradient(135deg, rgba(16,185,129,0.15), rgba(16,185,129,0.05));">
                <span class="material-symbols-outlined" style="color: #34d399; font-variation-settings:'FILL' 1;">description</span>
            </div>
            <div class="glow-dot" style="background: #34d399;"></div>
        </div>
        <p class="text-[28px] font-extrabold text-white tracking-tight leading-none" data-count="@Model.ActiveContracts">0</p>
        <p class="text-[11px] font-medium mt-1.5" style="color: rgba(148,163,184,0.6);">Hợp đồng hoạt động</p>
    </div>

    <!-- Revenue -->
    <div class="stat-card animate-fade-in animate-delay-3">
        <div class="flex items-center justify-between mb-4">
            <div class="stat-icon" style="background: linear-gradient(135deg, rgba(249,115,22,0.15), rgba(249,115,22,0.05));">
                <span class="material-symbols-outlined" style="color: #fb923c; font-variation-settings:'FILL' 1;">payments</span>
            </div>
            <div class="glow-dot" style="background: #fb923c;"></div>
        </div>
        <p class="text-[28px] font-extrabold text-white tracking-tight leading-none" data-count="@Model.TotalRevenue" data-suffix="đ">0</p>
        <p class="text-[11px] font-medium mt-1.5" style="color: rgba(148,163,184,0.6);">Tổng doanh thu</p>
    </div>

    <!-- Open Tickets -->
    <div class="stat-card animate-fade-in animate-delay-4">
        <div class="flex items-center justify-between mb-4">
            <div class="stat-icon" style="background: linear-gradient(135deg, rgba(239,68,68,0.15), rgba(239,68,68,0.05));">
                <span class="material-symbols-outlined" style="color: #f87171; font-variation-settings:'FILL' 1;">build</span>
            </div>
            <div class="glow-dot" style="background: #f87171;"></div>
        </div>
        <p class="text-[28px] font-extrabold text-white tracking-tight leading-none" data-count="@Model.OpenTickets">0</p>
        <p class="text-[11px] font-medium mt-1.5" style="color: rgba(148,163,184,0.6);">Ticket đang mở</p>
    </div>
</div>

<!-- ═══ Quick Stats Row ═══ -->
<div class="grid grid-cols-3 gap-4 mb-8">
    <div class="flex items-center gap-3 p-4 rounded-2xl animate-fade-in animate-delay-3"
         style="background: rgba(15,23,42,0.5); border: 1px solid rgba(56,78,122,0.12);">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(139,92,246,0.1);">
            <span class="material-symbols-outlined text-lg" style="color: #a78bfa; font-variation-settings:'FILL' 1;">group</span>
        </div>
        <div>
            <p class="text-lg font-bold text-white" data-count="@Model.TotalUsers">0</p>
            <p class="text-[10px]" style="color: rgba(148,163,184,0.5);">Người dùng</p>
        </div>
    </div>
    <div class="flex items-center gap-3 p-4 rounded-2xl animate-fade-in animate-delay-4"
         style="background: rgba(15,23,42,0.5); border: 1px solid rgba(56,78,122,0.12);">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(56,189,248,0.1);">
            <span class="material-symbols-outlined text-lg" style="color: #38bdf8; font-variation-settings:'FILL' 1;">apartment</span>
        </div>
        <div>
            <p class="text-lg font-bold text-white" data-count="@Model.TotalBuildings">0</p>
            <p class="text-[10px]" style="color: rgba(148,163,184,0.5);">Tòa nhà</p>
        </div>
    </div>
    <div class="flex items-center gap-3 p-4 rounded-2xl animate-fade-in animate-delay-5"
         style="background: rgba(15,23,42,0.5); border: 1px solid rgba(56,78,122,0.12);">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(249,115,22,0.1);">
            <span class="material-symbols-outlined text-lg" style="color: #fb923c; font-variation-settings:'FILL' 1;">trending_up</span>
        </div>
        <div>
            <p class="text-lg font-bold text-white" data-count="@Model.OccupancyRate" data-suffix="%" data-decimal="true">0</p>
            <p class="text-[10px]" style="color: rgba(148,163,184,0.5);">Tỷ lệ thuê</p>
        </div>
    </div>
</div>

<!-- ═══ Charts ═══ -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-5 mb-8">
    <!-- Revenue Chart -->
    <div class="xl:col-span-2 premium-card animate-fade-in animate-delay-4">
        <div class="premium-card-header">
            <div>
                <h3 class="text-[13px] font-bold text-white">Doanh thu 30 ngày</h3>
                <p class="text-[10px] mt-0.5" style="color: rgba(148,163,184,0.4);">Biểu đồ doanh thu theo ngày</p>
            </div>
            <span class="badge badge-accent">@Model.RevenueLast30Days.Count ngày</span>
        </div>
        <div class="premium-card-body">
            <div class="h-[260px]">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Occupancy Donut -->
    <div class="premium-card animate-fade-in animate-delay-5">
        <div class="premium-card-header">
            <div>
                <h3 class="text-[13px] font-bold text-white">Chiếm chỗ</h3>
                <p class="text-[10px] mt-0.5" style="color: rgba(148,163,184,0.4);">Tỷ lệ phòng đã thuê</p>
            </div>
        </div>
        <div class="premium-card-body flex flex-col items-center justify-center">
            <div class="relative w-44 h-44">
                <canvas id="occupancyChart"></canvas>
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center">
                        <p class="text-3xl font-extrabold text-white tracking-tight">@Model.OccupancyRate%</p>
                        <p class="text-[10px] mt-0.5" style="color: rgba(148,163,184,0.4);">Đã thuê</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ AI Section ═══ -->
<div class="grid grid-cols-1 xl:grid-cols-2 gap-5 mb-8">
    <!-- AI Insights -->
    <div class="premium-card animate-fade-in animate-delay-5" style="border-color: rgba(139,92,246,0.2);">
        <div class="premium-card-header" style="border-color: rgba(139,92,246,0.1);">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(168,85,247,0.1));">
                    <span class="material-symbols-outlined text-base" style="color: #a78bfa; font-variation-settings:'FILL' 1;">auto_awesome</span>
                </div>
                <div>
                    <h3 class="text-[13px] font-bold text-white">AI Insights</h3>
                    <p class="text-[9px]" style="color: rgba(148,163,184,0.4);">Powered by Gemini</p>
                </div>
            </div>
            <span class="badge" style="background: rgba(139,92,246,0.08); color: #a78bfa; border: 1px solid rgba(139,92,246,0.15);">
                <span class="material-symbols-outlined text-[10px]">psychology</span> AI
            </span>
        </div>
        <div class="premium-card-body">
            @if (!string.IsNullOrEmpty(Model.AiInsights))
            {
                <div class="space-y-2.5">
                    @foreach (var line in Model.AiInsights.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p class="text-[12px] leading-relaxed" style="color: rgba(203,213,225,0.8);">@line</p>
                    }
                </div>
            }
            else
            {
                <p class="text-[12px]" style="color: rgba(148,163,184,0.4);">Đang phân tích dữ liệu...</p>
            }
        </div>
    </div>

    <!-- Sentiment Analysis -->
    <div class="premium-card animate-fade-in animate-delay-6" style="border-color: rgba(56,189,248,0.2);">
        <div class="premium-card-header" style="border-color: rgba(56,189,248,0.1);">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, rgba(56,189,248,0.15), rgba(59,130,246,0.1));">
                    <span class="material-symbols-outlined text-base" style="color: #38bdf8; font-variation-settings:'FILL' 1;">sentiment_satisfied</span>
                </div>
                <div>
                    <h3 class="text-[13px] font-bold text-white">Phân tích Sentiment</h3>
                    <p class="text-[9px]" style="color: rgba(148,163,184,0.4);">Cảm xúc từ đánh giá</p>
                </div>
            </div>
        </div>
        <div class="premium-card-body">
            @{
                var total = Model.SentimentPositive + Model.SentimentNeutral + Model.SentimentNegative;
                var posPct = total > 0 ? (double)Model.SentimentPositive / total * 100 : 0;
                var neuPct = total > 0 ? (double)Model.SentimentNeutral / total * 100 : 0;
                var negPct = total > 0 ? (double)Model.SentimentNegative / total * 100 : 0;
            }

            <!-- Sentiment Bars -->
            <div class="space-y-3 mb-4">
                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="font-medium" style="color: #34d399;">😊 Tích cực</span>
                        <span class="font-bold" style="color: #34d399;">@Model.SentimentPositive (@posPct.ToString("F0")%)</span>
                    </div>
                    <div class="h-2 rounded-full overflow-hidden" style="background: rgba(16,185,129,0.08);">
                        <div class="h-full rounded-full transition-all duration-1000" style="width: @posPct%; background: linear-gradient(90deg, #34d399, #10b981);"></div>
                    </div>
                </div>
                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="font-medium" style="color: #fbbf24;">😐 Trung lập</span>
                        <span class="font-bold" style="color: #fbbf24;">@Model.SentimentNeutral (@neuPct.ToString("F0")%)</span>
                    </div>
                    <div class="h-2 rounded-full overflow-hidden" style="background: rgba(245,158,11,0.08);">
                        <div class="h-full rounded-full transition-all duration-1000" style="width: @neuPct%; background: linear-gradient(90deg, #fbbf24, #f59e0b);"></div>
                    </div>
                </div>
                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="font-medium" style="color: #f87171;">😞 Tiêu cực</span>
                        <span class="font-bold" style="color: #f87171;">@Model.SentimentNegative (@negPct.ToString("F0")%)</span>
                    </div>
                    <div class="h-2 rounded-full overflow-hidden" style="background: rgba(239,68,68,0.08);">
                        <div class="h-full rounded-full transition-all duration-1000" style="width: @negPct%; background: linear-gradient(90deg, #f87171, #ef4444);"></div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.SentimentSummary))
            {
                <div class="p-3 rounded-xl" style="background: rgba(56,189,248,0.04); border: 1px solid rgba(56,189,248,0.08);">
                    <p class="text-[11px] leading-relaxed" style="color: rgba(148,163,184,0.7);">
                        <span class="material-symbols-outlined text-[12px] align-middle mr-1" style="color: #38bdf8;">smart_toy</span>
                        @Model.SentimentSummary
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══ Bottom Row ═══ -->
<div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
    <!-- Top Rooms -->
    <div class="premium-card animate-fade-in animate-delay-5">
        <div class="premium-card-header">
            <div>
                <h3 class="text-[13px] font-bold text-white">Top phòng nổi bật</h3>
                <p class="text-[10px] mt-0.5" style="color: rgba(148,163,184,0.4);">Phòng có nhiều đánh giá nhất</p>
            </div>
            <a asp-action="Rooms" class="text-[11px] font-semibold" style="color: #fb923c;">Xem tất cả →</a>
        </div>
        <div class="p-2">
            @if (Model.TopViewedRooms.Any())
            {
                @foreach (var room in Model.TopViewedRooms)
                {
                    <div class="list-item">
                        <div class="avatar avatar-md" style="background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(168,85,247,0.2));">
                            <span class="material-symbols-outlined text-[15px]" style="color: #a5b4fc;">home</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-[13px] font-semibold text-white truncate">@room.Title</p>
                            <p class="text-[10px] truncate" style="color: rgba(148,163,184,0.5);">@room.Address</p>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <p class="text-[13px] font-bold" style="color: #fb923c;">@room.BasePrice.ToString("N0")đ</p>
                            <p class="text-[10px]" style="color: rgba(148,163,184,0.4);">@room.ReviewCount đánh giá</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><span class="material-symbols-outlined">inbox</span><p class="text-[12px]">Chưa có dữ liệu</p></div>
            }
        </div>
    </div>

    <!-- Recent Users -->
    <div class="premium-card animate-fade-in animate-delay-6">
        <div class="premium-card-header">
            <div>
                <h3 class="text-[13px] font-bold text-white">Người dùng mới</h3>
                <p class="text-[10px] mt-0.5" style="color: rgba(148,163,184,0.4);">Tài khoản đăng ký gần đây</p>
            </div>
            <a asp-action="Users" class="text-[11px] font-semibold" style="color: #fb923c;">Xem tất cả →</a>
        </div>
        <div class="p-2">
            @if (Model.RecentUsers.Any())
            {
                @foreach (var user in Model.RecentUsers)
                {
                    var gradients = new[] {
                        "linear-gradient(135deg, #f97316, #db2777)",
                        "linear-gradient(135deg, #6366f1, #8b5cf6)",
                        "linear-gradient(135deg, #0ea5e9, #6366f1)",
                        "linear-gradient(135deg, #22c55e, #16a34a)",
                        "linear-gradient(135deg, #eab308, #f97316)"
                    };
                    var idx = Model.RecentUsers.ToList().IndexOf(user) % gradients.Length;

                    <div class="list-item">
                        <div class="avatar avatar-md" style="background: @gradients[idx];">
                            @user.FullName.Substring(0, 1).ToUpper()
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-[13px] font-semibold text-white truncate">@user.FullName</p>
                            <p class="text-[10px] truncate" style="color: rgba(148,163,184,0.5);">@user.Email</p>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <span class="badge @(user.Role == "Admin" || user.Role == "Administrator" ? "badge-danger" : user.Role == "PropertyOwner" || user.Role == "Landlord" ? "badge-warning" : "badge-info")">@user.Role</span>
                            <p class="text-[9px] mt-1" style="color: rgba(148,163,184,0.3);">@user.CreatedAt.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><span class="material-symbols-outlined">person_off</span><p class="text-[12px]">Chưa có người dùng mới</p></div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Revenue Chart — Premium Style
    const revenueCtx = document.getElementById('revenueChart').getContext('2d');
    const gradient = revenueCtx.createLinearGradient(0, 0, 0, 260);
    gradient.addColorStop(0, 'rgba(249, 115, 22, 0.12)');
    gradient.addColorStop(1, 'rgba(249, 115, 22, 0)');

    new Chart(revenueCtx, {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLast30Days.Select(r => r.Date))),
            datasets: [{
                label: 'Doanh thu',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLast30Days.Select(r => r.Amount))),
                borderColor: '#f97316',
                backgroundColor: gradient,
                fill: true,
                tension: 0.45,
                borderWidth: 2,
                pointRadius: 0,
                pointHoverRadius: 5,
                pointHoverBackgroundColor: '#f97316',
                pointHoverBorderColor: '#0c1120',
                pointHoverBorderWidth: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: 'rgba(15,23,42,0.95)',
                    borderColor: 'rgba(56,78,122,0.2)',
                    borderWidth: 1,
                    titleColor: '#f1f5f9',
                    bodyColor: '#94a3b8',
                    padding: 12,
                    cornerRadius: 10,
                    titleFont: { weight: '700', size: 12 },
                    bodyFont: { size: 11 },
                    displayColors: false,
                    callbacks: { label: ctx => new Intl.NumberFormat('vi-VN').format(ctx.raw) + ' đ' }
                }
            },
            scales: {
                x: { grid: { color: 'rgba(56,78,122,0.06)' }, ticks: { color: 'rgba(148,163,184,0.3)', font: { size: 10, weight: '500' } } },
                y: { grid: { color: 'rgba(56,78,122,0.06)' }, ticks: { color: 'rgba(148,163,184,0.3)', font: { size: 10, weight: '500' }, callback: v => (v/1000000).toFixed(1) + 'M' } }
            }
        }
    });

    // Occupancy Donut — Premium Style
    const occCtx = document.getElementById('occupancyChart').getContext('2d');
    new Chart(occCtx, {
        type: 'doughnut',
        data: {
            labels: ['Đã thuê', 'Trống'],
            datasets: [{
                data: [@Model.OccupancyRate, @(100 - Model.OccupancyRate)],
                backgroundColor: ['#f97316', 'rgba(56,78,122,0.15)'],
                borderColor: ['rgba(249,115,22,0.3)', 'rgba(56,78,122,0.1)'],
                borderWidth: 2,
                borderRadius: 6,
                spacing: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '80%',
            plugins: { legend: { display: false }, tooltip: { enabled: false } },
            animation: { animateRotate: true, duration: 1500, easing: 'easeOutQuart' }
        }
    });
</script>
}
