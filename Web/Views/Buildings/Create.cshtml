@{
    ViewData["Title"] = "Thiết lập Tòa nhà";
}

<div class="max-w-6xl mx-auto px-4 py-6 pb-24 relative" id="wizard-container">
    
    <div id="step-1">
        <div class="flex items-center gap-4 mb-6">
            <a href="@Url.Action("Index")" class="p-2 rounded-full hover:bg-gray-100 text-gray-500 transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Thiết lập Tòa nhà mới</h2>
                <p class="text-sm text-gray-500">Bước 1/2: Thông tin chung & Dịch vụ</p>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Tên tòa nhà <span class="text-red-500">*</span></label>
                    <input type="text" id="b-name" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:border-orange-500 outline-none transition-all" placeholder="Ví dụ: Chung cư mini Hoa Hồng" />
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Loại hình</label>
                    <select id="b-type" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:border-orange-500 outline-none">
                        <option value="Dãy trọ">Dãy trọ</option>
                        <option value="Chung cư mini">Chung cư mini (CHMN)</option>
                        <option value="Nhà nguyên căn">Nhà nguyên căn</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Thành phố <span class="text-red-500">*</span></label>
                    <input type="text" id="b-province" value="Đà Nẵng" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" />
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Quận/Huyện <span class="text-red-500">*</span></label>
                    <input type="text" id="b-district" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" placeholder="Ví dụ: Liên Chiểu" />
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Phường/Xã <span class="text-red-500">*</span></label>
                    <input type="text" id="b-ward" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" placeholder="Ví dụ: Hòa Khánh Bắc" />
                </div>
                <div class="md:col-span-3">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Số nhà, Tên đường <span class="text-red-500">*</span></label>
                    <input type="text" id="b-address" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" placeholder="Ví dụ: 123 Tôn Đức Thắng" />
                </div>
            </div>
            
            <hr class="border-gray-100" />
            <h3 class="font-bold text-gray-900">Bảng giá dịch vụ chung</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Giá Điện (đ/Kwh)</label>
                    <input type="number" id="b-elec" value="3500" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Giá Nước (đ/Khối)</label>
                    <input type="number" id="b-water" value="15000" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Wifi (đ/Tháng)</label>
                    <input type="number" id="b-internet" value="100000" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Rác (đ/Tháng)</label>
                    <input type="number" id="b-garbage" value="30000" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg" />
                </div>
            </div>
        </div>

        <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 flex justify-end z-50">
            <button onclick="nextStep()" class="bg-orange-500 text-white px-8 py-2.5 rounded-lg font-bold shadow-md hover:bg-orange-600 transition-all">
                Lưu & Tiếp tục <span class="material-symbols-outlined align-middle text-sm">arrow_forward</span>
            </button>
        </div>
    </div>

    <div id="step-2" class="hidden">
        <div class="flex items-center gap-4 mb-6">
            <button onclick="prevStep()" class="p-2 rounded-full hover:bg-gray-100 text-gray-500 transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Cấu trúc Tòa nhà</h2>
                <p class="text-sm text-gray-500">Bước 2/2: Sinh phòng tự động</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-4 bg-white rounded-xl shadow-sm border border-gray-200 p-6 self-start">
                <h3 class="font-bold text-gray-900 mb-4">Thông số cấu trúc</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Số Tầng</label>
                        <input type="number" id="struct-floors" value="3" min="1" max="50" onchange="generatePreview()" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-lg font-bold text-center" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Số phòng chuẩn mỗi tầng</label>
                        <input type="number" id="struct-rooms" value="4" min="1" max="20" onchange="generatePreview()" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-lg font-bold text-center" />
                    </div>
                </div>
                <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-100">
                    <p class="text-xs text-blue-800">
                        <span class="material-symbols-outlined text-sm align-middle">lightbulb</span>
                        Hệ thống sẽ tự động đặt tên phòng theo quy tắc: Tầng 2 + Phòng 3 = 203.
                    </p>
                </div>
            </div>

            <div class="lg:col-span-8 bg-gray-50 rounded-xl border-2 border-dashed border-gray-300 p-6 overflow-x-auto">
                <h3 class="font-bold text-gray-500 mb-4 uppercase text-sm tracking-wider">Mô phỏng trước cấu trúc</h3>
                
                <div id="preview-grid" class="space-y-4 flex flex-col-reverse">
                </div>
            </div>
        </div>

        <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 flex justify-end z-50 gap-4">
            <button onclick="prevStep()" class="px-6 py-2.5 text-gray-600 font-medium hover:bg-gray-100 rounded-lg transition-all">Quay lại</button>
            <button onclick="submitWizard()" id="btn-submit" class="bg-green-500 text-white px-8 py-2.5 rounded-lg font-bold shadow-md shadow-green-500/30 hover:bg-green-600 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">done_all</span> Khởi tạo Tòa nhà
            </button>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // JS điều khiển Wizard
        function nextStep() {
            // Validate sơ bộ
            if(!document.getElementById('b-name').value || !document.getElementById('b-address').value) {
                alert("Vui lòng nhập tên tòa nhà và địa chỉ!");
                return;
            }
            document.getElementById('step-1').classList.add('hidden');
            document.getElementById('step-2').classList.remove('hidden');
            window.scrollTo(0,0);
            generatePreview();
        }

        function prevStep() {
            document.getElementById('step-2').classList.add('hidden');
            document.getElementById('step-1').classList.remove('hidden');
            window.scrollTo(0,0);
        }

        // Logic sinh giao diện xem trước (Preview)
        function generatePreview() {
            const floors = parseInt(document.getElementById('struct-floors').value) || 1;
            const rooms = parseInt(document.getElementById('struct-rooms').value) || 1;
            const container = document.getElementById('preview-grid');
            container.innerHTML = '';

            for (let i = 1; i <= floors; i++) {
                let roomsHtml = '';
                for (let j = 1; j <= rooms; j++) {
                    const roomName = (i * 100) + j;
                    roomsHtml += `
                        <div class="flex-1 h-12 border border-orange-200 bg-orange-50 rounded flex items-center justify-center text-xs font-bold text-orange-600 shadow-sm">
                            P.${roomName}
                        </div>
                    `;
                }

                const floorHtml = `
                    <div class="flex items-center gap-4">
                        <div class="w-20 text-right">
                            <span class="text-xs font-bold text-gray-500 uppercase">Tầng ${i}</span>
                        </div>
                        <div class="flex-1 bg-white border border-gray-200 p-3 rounded-lg shadow-sm flex gap-3">
                            ${roomsHtml}
                        </div>
                    </div>
                `;
                // Dùng insertAdjacentHTML để xếp ngược từ Tầng cao nhất xuống tầng 1
                container.insertAdjacentHTML('afterbegin', floorHtml);
            }
        }

        // Đẩy JSON xuống API C#
        async function submitWizard() {
            const btn = document.getElementById('btn-submit');
            btn.innerHTML = `<span class="material-symbols-outlined animate-spin">sync</span> Đang xử lý...`;
            btn.disabled = true;

            const payload = {
                Config: {
                    Name: document.getElementById('b-name').value,
                    BuildingType: document.getElementById('b-type').value,
                    Province: document.getElementById('b-province').value,
                    District: document.getElementById('b-district').value,
                    Ward: document.getElementById('b-ward').value,
                    StreetAddress: document.getElementById('b-address').value,
                    ElectricityPrice: parseFloat(document.getElementById('b-elec').value) || 0,
                    WaterPrice: parseFloat(document.getElementById('b-water').value) || 0,
                    InternetPrice: parseFloat(document.getElementById('b-internet').value) || 0,
                    GarbagePrice: parseFloat(document.getElementById('b-garbage').value) || 0
                },
                Structure: {
                    NumberOfFloors: parseInt(document.getElementById('struct-floors').value),
                    RoomsPerFloor: parseInt(document.getElementById('struct-rooms').value)
                }
            };

            try {
                const response = await fetch('/Buildings/CreateData', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                const data = await response.json();
                if(data.success) {
                    alert("Khởi tạo thành công! Hệ thống đã tạo lưới phòng tự động.");
                    window.location.href = '/Buildings/Details/' + data.buildingId;
                } else {
                    alert("Lỗi: " + data.message);
                    btn.innerHTML = `<span class="material-symbols-outlined text-sm">done_all</span> Khởi tạo Tòa nhà`;
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert("Lỗi kết nối Server.");
                btn.disabled = false;
            }
        }
    </script>
}