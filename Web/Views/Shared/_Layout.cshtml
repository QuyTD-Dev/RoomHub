        <script>
            // Logic Thông báo kiểu Facebook
            const bellBtn = document.getElementById('nav-notification-bell');
            const dropdown = document.getElementById('notification-dropdown');
            const list = document.getElementById('notification-list');
            const badge = document.getElementById('notification-badge');
            let isDropdownOpen = false;

            // Toggle Dropdown
            if(bellBtn) {
                bellBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    isDropdownOpen = !isDropdownOpen;
                    dropdown.classList.toggle('hidden');
                    if (isDropdownOpen) fetchNotifications();
                });
            }

            document.addEventListener('click', (e) => {
                if (dropdown && !dropdown.contains(e.target) && !bellBtn.contains(e.target)) {
                    dropdown.classList.add('hidden');
                    isDropdownOpen = false;
                }
            });

            // Tự động fetch số lượng unread khi vừa vào trang
            document.addEventListener('DOMContentLoaded', updateUnreadBadge);

            async function updateUnreadBadge() {
                try {
                    const res = await fetch('/Notifications/GetTop');
                    console.log("Status lấy thông báo:", res.status);
                    const data = await res.json();
                    console.log("Dữ liệu thông báo nhận được:", data);
                    
                    // Xử lý linh hoạt cả PascalCase và camelCase
                    const unreadCount = data.unreadCount !== undefined ? data.unreadCount : data.UnreadCount;
                    const notifications = data.notifications !== undefined ? data.notifications : data.Notifications;

                    if (unreadCount > 0) {
                        badge.innerText = unreadCount > 9 ? '9+' : unreadCount;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                    
                    // Nếu là Tenant và có mời thuê mới thì auto-popup
                    @if (User.IsInRole("Tenant")) {
                        <text>
                        if (notifications && Array.isArray(notifications)) {
                            const invitations = notifications.filter(n => {
                                const type = n.type || n.Type;
                                const isRead = n.isRead !== undefined ? n.isRead : n.IsRead;
                                return type === 'ContractAssign' && !isRead;
                            });
                            if(invitations.length > 0) {
                                // Tùy chọn: showPendingInvitationPopup(invitations[0].linkedId || invitations[0].LinkedId);
                            }
                        }
                        </text>
                    }
                } catch(e) {
                    console.error("Lỗi cập nhật Badge thông báo:", e);
                }
            }

            async function fetchNotifications() {
                list.innerHTML = `<div class="p-8 text-center text-gray-400"><span class="material-symbols-outlined animate-spin text-2xl">sync</span></div>`;
                try {
                    const res = await fetch('/Notifications/GetTop');
                    const data = await res.json();
                    
                    const notifications = data.notifications !== undefined ? data.notifications : data.Notifications;

                    if (!notifications || notifications.length === 0) {
                        list.innerHTML = `<div class="p-10 text-center text-gray-400"><p class="text-sm">Bạn chưa có thông báo nào.</p></div>`;
                        return;
                    }

                    list.innerHTML = notifications.map(n => {
                        const id = n.id || n.Id;
                        const type = n.type || n.Type;
                        const title = n.title || n.Title;
                        const content = n.content || n.Content;
                        const timeAgo = n.timeAgo || n.TimeAgo;
                        const isRead = n.isRead !== undefined ? n.isRead : n.IsRead;
                        const linkedId = n.linkedId !== undefined ? n.linkedId : n.LinkedId;

                        return `
                            <div onclick="handleNotifClick(${id}, '${type}', ${linkedId})" 
                                 class="p-4 hover:bg-gray-50 flex gap-3 cursor-pointer transition-colors ${isRead ? '' : 'bg-blue-50/50'}" id="notif-${id}">
                                <div class="w-11 h-11 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">${getIconForType(type)}</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-bold text-gray-900 leading-tight mb-1">${title}</p>
                                    <p class="text-xs text-gray-600 line-clamp-2 mb-1">${content}</p>
                                    <span class="text-[10px] font-bold text-blue-600 uppercase tracking-tighter">${timeAgo}</span>
                                </div>
                                ${isRead ? '' : '<div class="w-2.5 h-2.5 bg-blue-600 rounded-full mt-2 shrink-0"></div>'}
                            </div>
                        `;
                    }).join('');
                } catch(e) {
                    console.error("Lỗi lấy danh sách thông báo:", e);
                    list.innerHTML = `<div class="p-8 text-center text-red-400 group"><span class="material-symbols-outlined">error</span><p class="text-xs">Lỗi tải dữ liệu.</p></div>`;
                }
            }

            function getIconForType(type) {
                switch(type) {
                    case 'ContractAssign': return 'assignment_ind';
                    case 'ContractResponse': return 'handshake';
                    case 'Billing': return 'receipt_long';
                    default: return 'notifications';
                }
            }

            async function handleNotifClick(requestId, type, linkedId) {
                // 1. Mark as read on server
                fetch('/Notifications/MarkAsRead/' + requestId, { method: 'POST' });
                
                // 2. Update UI
                const item = document.getElementById('notif-' + requestId);
                if(item) {
                    item.classList.remove('bg-blue-50/50');
                    const dot = item.querySelector('.bg-blue-600.rounded-full');
                    if(dot) dot.remove();
                }
                updateUnreadBadge();

                // 3. Action based on type
                if (type === 'ContractAssign') {
                    // Mở popup nhận phòng (Lấy lại dữ liệu hợp đồng bản nháp)
                    showPendingInvitationPopup(linkedId);
                } else if (type === 'ContractResponse') {
                    // Nếu chủ nhà nhận phản hồi, click vào sẽ load lại trang để thấy màu phòng thay đổi
                    window.location.reload();
                }
            }

            async function markAllNotificationsAsRead() {
                try {
                    await fetch('/Notifications/MarkAllAsRead', { method: 'POST' });
                    updateUnreadBadge();
                    fetchNotifications();
                } catch(e) {}
            }

            // Logic Popup (Mượn từ cũ nhưng tối ưu)
            async function showPendingInvitationPopup(contractId) {
                Swal.fire({
                    title: 'Đang chuẩn bị...',
                    didOpen: () => Swal.showLoading()
                });

                // Cần 1 API để lấy nhanh info contract từ ID
                try {
                    const res = await fetch('/TenantBilling/GetPendingContracts'); // API cũ của bạn trả về danh sách
                    const data = await res.json();
                    
                    // Hỗ trợ cả PascalCase và camelCase cho data trả về từ Controller
                    const list = data.data !== undefined ? data.data : data.Data;
                    const c = list ? list.find(x => (x.contractId || x.ContractId) == contractId) : null;

                    if(!c) {
                        console.warn("Không tìm thấy hợp đồng ID:", contractId, "trong danh sách:", list);
                        Swal.fire('Thông báo', 'Hợp đồng này không còn tồn tại hoặc đã được xử lý.', 'warning');
                        return;
                    }

                    const ownerName = c.ownerName || c.OwnerName;
                    const roomNumber = c.roomNumber || c.RoomNumber;
                    const date = c.date || c.Date;
                    const rent = c.rent !== undefined ? c.rent : c.Rent;

                    Swal.fire({
                        title: 'Lời Mời Nhận Phòng!',
                        html: `Chủ nhà <b>${ownerName}</b> mời bạn vào Phòng <b>P.${roomNumber}</b><br>
                               Ngày ở: <b>${date}</b><br>
                               Giá: <b class="text-red-500">${rent.toLocaleString()} đ/tháng</b>`,
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonText: 'Đồng ý',
                        cancelButtonText: 'Từ chối'
                    }).then(async (result) => {
                        if (result.isConfirmed) await submitInvitationResponse(contractId, true);
                        else if (result.dismiss === Swal.DismissReason.cancel) await submitInvitationResponse(contractId, false);
                    });
                } catch(e) { 
                    console.error("Lỗi khi mở popup lời mời:", e);
                    Swal.close(); 
                }
            }

            async function submitInvitationResponse(id, accept) {
                Swal.fire({ title: 'Đang xử lý...', didOpen: () => Swal.showLoading() });
                const res = await fetch('/TenantBilling/RespondToContract?contractId=' + id + '&accept=' + accept, { method: 'POST' });
                const d = await res.json();
                if(d.success) {
                    Swal.fire({ title: 'Hoàn tất!', icon: 'success', timer: 1500, showConfirmButton: false })
                        .then(() => window.location.reload());
                } else {
                    Swal.fire('Lỗi', d.message, 'error');
                }
            }
        </script>
    }

    <script src="~/js/layout.js"></script>
    <script>
        // Sync location dropdown selection -> hidden input in search form
        (function() {
            var locInput = document.getElementById('location-hidden-input');
            var syncInput = document.getElementById('search-province-sync');
            var locLabel = document.getElementById('location-label');
            if (!locInput || !syncInput) return;

            // Preserve from query string on load
            var initial = syncInput.value;
            if (initial && locLabel) {
                locLabel.textContent = initial || 'To\u00e0n qu\u1ed1c';
                locInput.value = initial;
            }

            // Observer: whenever location-hidden-input changes, sync to search form
            var observer = new MutationObserver(function() {
                syncInput.value = locInput.value;
            });
            observer.observe(locInput, { attributes: true, attributeFilter: ['value'] });

            // Also watch via direct assignment intercept
            var _val = locInput.value;
            Object.defineProperty(locInput, 'value', {
                get: function() { return _val; },
                set: function(v) {
                    _val = v;
                    syncInput.value = v;
                    if (locLabel) locLabel.textContent = v || 'To\u00e0n qu\u1ed1c';
                }
            });
        })();
    </script>

    @* ===== SEARCH SUGGESTIONS DROPDOWN SCRIPT ===== *@
    <script>
    (function () {
        var searchInput   = document.getElementById('header-search-input');
        var panel         = document.getElementById('search-suggestions-panel');
        var listEl        = document.getElementById('search-suggestions-list');
        var loadingEl     = document.getElementById('search-suggestions-loading');
        var emptyEl       = document.getElementById('search-suggestions-empty');
        var footerEl      = document.getElementById('search-suggestions-footer');

        if (!searchInput || !panel) return;

        var debounceTimer = null;
        var currentQuery  = '';
        var activeIndex   = -1;
        var suggestions   = [];

        // ── Helpers ──────────────────────────────────────────────
        function formatPrice(price) {
            if (!price && price !== 0) return 'Liên hệ';
            if (price >= 1000000) {
                var m = (price / 1000000).toFixed(1).replace(/\.0$/, '');
                return m + ' triệu/tháng';
            }
            return price.toLocaleString('vi-VN') + ' đ/tháng';
        }

        function highlightText(text, query) {
            if (!query) return text;
            var escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            var regex = new RegExp('(' + escaped + ')', 'gi');
            return text.replace(regex, '<mark class="bg-orange-100 dark:bg-orange-900/40 text-primary rounded px-0.5">$1</mark>');
        }

        function showPanel() {
            panel.classList.remove('hidden');
        }

        function hidePanel() {
            panel.classList.add('hidden');
            activeIndex = -1;
            clearActive();
        }

        function setLoading(on) {
            loadingEl.classList.toggle('hidden', !on);
            if (on) {
                listEl.innerHTML = '';
                emptyEl.classList.add('hidden');
                footerEl.classList.add('hidden');
            }
        }

        function clearActive() {
            var items = listEl.querySelectorAll('li');
            items.forEach(function(li) { li.classList.remove('bg-orange-50', 'dark:bg-orange-900/20'); });
        }

        function setActive(idx) {
            clearActive();
            activeIndex = idx;
            var items = listEl.querySelectorAll('li');
            if (idx >= 0 && idx < items.length) {
                items[idx].classList.add('bg-orange-50', 'dark:bg-orange-900/20');
                items[idx].scrollIntoView({ block: 'nearest' });
            }
        }

        // ── Render Results ────────────────────────────────────────
        function renderSuggestions(data, query) {
            listEl.innerHTML = '';
            setLoading(false);

            if (!data || data.length === 0) {
                emptyEl.classList.remove('hidden');
                footerEl.classList.add('hidden');
                return;
            }

            emptyEl.classList.add('hidden');
            footerEl.classList.remove('hidden');

            suggestions = data;
            activeIndex = -1;

            data.forEach(function(room, i) {
                var li = document.createElement('li');
                li.setAttribute('role', 'option');
                li.dataset.id = room.id;
                li.className = 'flex items-center gap-3 px-3 py-2.5 mx-2 rounded-xl cursor-pointer transition-colors hover:bg-orange-50 dark:hover:bg-orange-900/20 group';

                var typeColor = {
                    0: 'bg-blue-100 text-blue-700',
                    1: 'bg-purple-100 text-purple-700',
                    2: 'bg-orange-100 text-orange-700',
                    3: 'bg-green-100 text-green-700',
                    4: 'bg-pink-100 text-pink-700',
                    5: 'bg-slate-100 text-slate-600'
                }[room.roomType] || 'bg-slate-100 text-slate-600';

                li.innerHTML =
                    '<div class="w-14 h-14 rounded-xl overflow-hidden flex-shrink-0 bg-slate-100">'
                    + '<img src="' + (room.mainPhotoUrl || '') + '" alt="' + room.title + '" class="w-full h-full object-cover" loading="lazy" onerror="this.src=\'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=400&q=70\'" />'
                    + '</div>'
                    + '<div class="flex-1 min-w-0">'
                    +   '<p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate leading-snug">' + highlightText(room.title, query) + '</p>'
                    +   '<p class="text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">' + (room.address || 'Chưa cập nhật') + '</p>'
                    +   '<div class="flex items-center gap-2 mt-1">'
                    +     '<span class="inline-block text-[10px] font-bold px-1.5 py-0.5 rounded-md ' + typeColor + '">' + (room.roomTypeLabel || '') + '</span>'
                    +     '<span class="text-xs font-bold text-primary">' + formatPrice(room.basePrice) + '</span>'
                    +   '</div>'
                    + '</div>'
                    + '<span class="material-symbols-outlined text-slate-200 group-hover:text-primary text-base transition-colors flex-shrink-0">chevron_right</span>';

                li.addEventListener('mousedown', function(e) {
                    e.preventDefault();
                    window.location.href = '/RoomPosts/Details/' + room.id;
                });

                li.addEventListener('mouseenter', function() { setActive(i); });

                listEl.appendChild(li);
            });
        }

        // ── Fetch ─────────────────────────────────────────────────
        function fetchSuggestions(query) {
            currentQuery = query;
            setLoading(true);
            showPanel();

            var provinceSync = document.getElementById('search-province-sync');
            var province = provinceSync ? provinceSync.value : '';
            var url = '/RoomPosts/SearchSuggestions?q=' + encodeURIComponent(query);
            if (province) url += '&province=' + encodeURIComponent(province);

            fetch(url)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (currentQuery !== query) return; // stale response
                    renderSuggestions(data, query);
                })
                .catch(function() {
                    setLoading(false);
                    emptyEl.classList.remove('hidden');
                });
        }

        // ── Events ────────────────────────────────────────────────
        searchInput.addEventListener('input', function() {
            var q = this.value.trim();
            clearTimeout(debounceTimer);

            if (q.length < 2) {
                hidePanel();
                return;
            }

            debounceTimer = setTimeout(function() { fetchSuggestions(q); }, 300);
        });

        searchInput.addEventListener('focus', function() {
            var q = this.value.trim();
            if (q.length >= 2 && suggestions.length > 0) showPanel();
        });

        // Keyboard navigation
        searchInput.addEventListener('keydown', function(e) {
            var items = listEl.querySelectorAll('li');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                setActive(Math.min(activeIndex + 1, items.length - 1));
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                setActive(Math.max(activeIndex - 1, -1));
                if (activeIndex === -1) searchInput.focus();
            } else if (e.key === 'Enter') {
                if (activeIndex >= 0 && suggestions[activeIndex]) {
                    e.preventDefault();
                    window.location.href = '/RoomPosts/Details/' + suggestions[activeIndex].id;
                }
            } else if (e.key === 'Escape') {
                hidePanel();
                searchInput.blur();
            }
        });

        // Click outside
        document.addEventListener('mousedown', function(e) {
            var form = document.getElementById('header-search-form');
            if (form && !form.contains(e.target)) hidePanel();
        });
    })();
    </script>

    @* ===== GLOBAL INCOMING VIDEO CALL LISTENER ===== *@
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Incoming Call Overlay (hiển thị trên MỌI trang) -->
        <div id="globalIncomingCallOverlay" class="fixed inset-0 z-[9998] hidden">
            <div class="absolute inset-0 bg-black/70 backdrop-blur-md"></div>
            <div class="relative z-10 w-full h-full flex items-center justify-center">
                <div class="text-center">
                    <div class="relative inline-block mb-6">
                        <div class="w-28 h-28 rounded-full bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center shadow-2xl relative z-10">
                            <span class="text-5xl font-bold text-white" id="globalIncomingAvatar">?</span>
                        </div>
                        <div class="absolute inset-0 w-28 h-28 rounded-full border-2 border-green-400/60 animate-ping"></div>
                        <div class="absolute -inset-3 rounded-full border border-green-400/30 animate-pulse"></div>
                    </div>
                    <h2 class="text-white text-2xl font-bold mb-1" id="globalIncomingName">Cuộc gọi đến</h2>
                    <p class="text-white/60 text-sm mb-10">Cuộc gọi video đến...</p>
                    <div class="flex items-center justify-center gap-8">
                        <button id="globalRejectCall" class="flex flex-col items-center gap-2 group">
                            <div class="w-16 h-16 rounded-full bg-red-500 hover:bg-red-600 flex items-center justify-center transition-all group-hover:scale-110 shadow-lg shadow-red-500/40">
                                <span class="material-symbols-outlined text-white text-3xl">call_end</span>
                            </div>
                            <span class="text-white/70 text-xs font-medium">Từ chối</span>
                        </button>
                        <button id="globalAcceptCall" class="flex flex-col items-center gap-2 group">
                            <div class="w-16 h-16 rounded-full bg-green-500 hover:bg-green-600 flex items-center justify-center transition-all group-hover:scale-110 shadow-lg shadow-green-500/40 animate-bounce">
                                <span class="material-symbols-outlined text-white text-3xl">videocam</span>
                            </div>
                            <span class="text-white/70 text-xs font-medium">Chấp nhận</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
        <script>
        (function() {
            'use strict';

            // Nếu đang ở trang Chat → Chat/Index.cshtml đã có listener riêng, không cần global
            if (window.location.pathname.toLowerCase().startsWith('/chat')) return;

            var globalCallConn = new signalR.HubConnectionBuilder()
                .withUrl("/videocallhub")
                .withAutomaticReconnect()
                .build();

            var globalIncomingCallerId = null;

            // Nhận cuộc gọi đến từ MỌI trang
            globalCallConn.on("IncomingCall", function(callerId, callerName) {
                console.log('[GlobalVideoCall] IncomingCall from ' + callerId + ' (' + callerName + ')');
                globalIncomingCallerId = callerId;

                var overlay = document.getElementById('globalIncomingCallOverlay');
                document.getElementById('globalIncomingName').textContent = callerName || 'Cuộc gọi đến';
                document.getElementById('globalIncomingAvatar').textContent = (callerName || '?').charAt(0).toUpperCase();
                overlay.classList.remove('hidden');
            });

            // Cuộc gọi kết thúc (caller hủy)
            globalCallConn.on("CallEnded", function() {
                document.getElementById('globalIncomingCallOverlay').classList.add('hidden');
                globalIncomingCallerId = null;
            });

            // Chấp nhận → chuyển đến trang Chat với caller
            document.getElementById('globalAcceptCall').addEventListener('click', function() {
                if (!globalIncomingCallerId) return;
                // Chuyển hướng đến trang Chat với caller, sẽ tự kết nối ở đó
                window.location.href = '/Chat?receiverId=' + encodeURIComponent(globalIncomingCallerId) + '&autoAcceptCall=' + encodeURIComponent(globalIncomingCallerId);
            });

            // Từ chối
            document.getElementById('globalRejectCall').addEventListener('click', function() {
                if (!globalIncomingCallerId) return;
                globalCallConn.invoke("RejectCall", globalIncomingCallerId).catch(function(e) {
                    console.error('[GlobalVideoCall] RejectCall error:', e);
                });
                document.getElementById('globalIncomingCallOverlay').classList.add('hidden');
                globalIncomingCallerId = null;
            });

            // Auto HangUp khi đóng tab
            window.addEventListener('beforeunload', function() {
                if (globalIncomingCallerId) {
                    globalCallConn.invoke("RejectCall", globalIncomingCallerId).catch(function() {});
                }
            });

            globalCallConn.start()
                .then(function() { console.log('[GlobalVideoCall] Connected'); })
                .catch(function(err) { console.error('[GlobalVideoCall] Connection error:', err); });
        })();
        </script>
    }
</body>
