@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center px-6">
        <div class="w-24 h-24 mx-auto mb-6 rounded-3xl flex items-center justify-center"
             style="background: rgba(239,68,68,0.1); border: 2px solid rgba(239,68,68,0.2);">
            <span class="material-symbols-outlined text-5xl" style="color: #f87171;">lock</span>
        </div>
        <h1 class="text-4xl font-extrabold text-gray-800 mb-3">403</h1>
        <h2 class="text-xl font-semibold text-gray-700 mb-3">Không có quyền truy cập</h2>
        <p class="text-gray-500 mb-8 max-w-md mx-auto">
            Bạn không có quyền truy cập trang này. Vui lòng liên hệ quản trị viên hoặc đăng nhập bằng tài khoản phù hợp.
        </p>
        <div class="flex gap-3 justify-center">
            <a href="/" class="px-6 py-3 rounded-xl font-semibold text-white transition-all duration-200 hover:opacity-90"
               style="background: linear-gradient(135deg, #f97316, #ea580c);">
                Về trang chủ
            </a>
            <a asp-controller="Auth" asp-action="Login"
               class="px-6 py-3 rounded-xl font-semibold border transition-all duration-200 hover:bg-gray-50"
               style="color: #374151; border-color: #d1d5db;">
                Đăng nhập lại
            </a>
        </div>
    </div>
</div>
