@section Scripts {
    <script src="~/js/favorite.js" asp-append-version="true"></script>
    <script>
        (function () {
            // ===== FIXED-POSITION DROPDOWN SYSTEM =====
            var activeMenu = null;

            function positionMenu(btn, menu) {
                var r = btn.getBoundingClientRect();
                menu.style.top = (r.bottom + 8) + 'px';
                menu.style.left = r.left + 'px';
                var menuW = menu.offsetWidth || 220;
                if (r.left + menuW > window.innerWidth - 16) {
                    menu.style.left = Math.max(16, r.right - menuW) + 'px';
                }
            }

            function openMenu(btn, menu) {
                if (activeMenu && activeMenu !== menu) closeAll();
                menu.classList.remove('hidden');
                positionMenu(btn, menu);
                activeMenu = menu;
            }

            function closeAll() {
                document.querySelectorAll('.filter-dropdown').forEach(function (m) { m.classList.add('hidden'); });
                activeMenu = null;
            }

            document.querySelectorAll('[data-dropdown]').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var menu = document.getElementById(btn.getAttribute('data-dropdown'));
                    if (!menu) return;
                    if (!menu.classList.contains('hidden')) { closeAll(); return; }
                    openMenu(btn, menu);
                });
            });

            function reposition() {
                if (!activeMenu) return;
                var btn = document.querySelector('[data-dropdown="' + activeMenu.id + '"]');
                if (btn) positionMenu(btn, activeMenu);
            }
            window.addEventListener('scroll', reposition, true);
            window.addEventListener('resize', reposition);

            document.addEventListener('click', function (e) {
                if (!activeMenu) return;
                var btn = document.querySelector('[data-dropdown="' + activeMenu.id + '"]');
                if (btn && btn.contains(e.target)) return;
                if (activeMenu.contains(e.target)) return;
                closeAll();
            });

            // Advanced filter panel
            var btnAdv = document.getElementById('btnAdvancedFilter');
            if (btnAdv) {
                btnAdv.addEventListener('click', function () {
                    document.getElementById('advancedFilterPanel').classList.toggle('hidden');
                });
            }
        })();
    </script>
}