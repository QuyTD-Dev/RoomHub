<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - RoomHub</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/RoomPosts/index.css" />
    <script src="~/js/RoomPosts/index.js"></script>
    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 2px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
        #mega-menu-sidebar { transition: transform .28s cubic-bezier(.4,0,.2,1); }
    </style>
</head>
<body class="bg-[#f4f4f4] dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen">

    @* Mega Menu Backdrop *@
    <div id="mega-menu-backdrop" class="fixed inset-0 bg-black/40 z-[150] opacity-0 pointer-events-none transition-opacity duration-300"></div>

    @* Mega Menu Sidebar *@
    <aside id="mega-menu-sidebar"
           class="fixed top-0 left-0 h-full w-[300px] bg-white dark:bg-slate-900 z-[160] -translate-x-full shadow-2xl flex flex-col">
        @* Header sidebar *@
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 dark:border-slate-800">
            <span class="text-primary text-xl font-black tracking-tight">RoomHub</span>
            <button id="mega-menu-close"
                    class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-slate-500">close</span>
            </button>
        </div>
        @* Body sidebar *@
        <div class="flex-1 overflow-y-auto p-4 space-y-1 custom-scrollbar">
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 px-3 pt-2 pb-1">Danh mục bất động sản</p>
            <a href="/RoomPosts/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-orange-50 dark:hover:bg-orange-900/20 hover:text-primary transition-colors">
                <span class="w-8 h-8 bg-orange-100 dark:bg-orange-900/30 rounded-lg flex items-center justify-center text-primary flex-shrink-0">
                    <span class="material-symbols-outlined" style="font-size:18px">apartment</span>
                </span>
                Phòng trọ / Căn hộ
            </a>
            <a href="/RoomPosts/Index?roomType=WholeHouse" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-orange-50 dark:hover:bg-orange-900/20 hover:text-primary transition-colors">
                <span class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center text-blue-600 flex-shrink-0">
                    <span class="material-symbols-outlined" style="font-size:18px">home</span>
                </span>
                Nhà nguyên căn
            </a>


            <div class="h-px bg-slate-100 dark:bg-slate-800 my-3"></div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 px-3 pb-1">Khu vực nổi bật</p>
            <a href="/RoomPosts/Index?province=TP.+H%E1%BB%93+Ch%C3%AD+Minh" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-orange-50 dark:hover:bg-orange-900/20 hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-primary" style="font-size:18px">location_on</span>
                TP. Hồ Chí Minh
            </a>
            <a href="/RoomPosts/Index?province=H%C3%A0+N%E1%BB%99i" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-orange-50 dark:hover:bg-orange-900/20 hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-primary" style="font-size:18px">location_on</span>
                Hà Nội
            </a>
            <a href="/RoomPosts/Index?province=%C4%90%C3%A0+N%E1%BA%B5ng" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-orange-50 dark:hover:bg-orange-900/20 hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-primary" style="font-size:18px">location_on</span>
                Đà Nẵng
            </a>
            <a href="/RoomPosts/Index?province=B%C3%ACnh+D%C6%B0%C6%A1ng" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-orange-50 dark:hover:bg-orange-900/20 hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-primary" style="font-size:18px">location_on</span>
                Bình Dương
            </a>


        </div>
        @* Footer sidebar *@
        <div class="p-4 border-t border-slate-100 dark:border-slate-800">
            @if (User.Identity.IsAuthenticated && !User.IsInRole("Tenant"))
            {
                <a asp-controller="RoomPosts" asp-action="Create"
                   class="flex items-center justify-center gap-2 w-full bg-primary text-white py-2.5 rounded-xl text-sm font-bold hover:bg-orange-600 transition">
                    <span class="material-symbols-outlined" style="font-size:18px">add_circle</span>
                    Đăng tin ngay
                </a>
            }
            else if (!User.Identity.IsAuthenticated)
            {
                <a asp-controller="Auth" asp-action="Login"
                   class="flex items-center justify-center gap-2 w-full border border-primary text-primary py-2.5 rounded-xl text-sm font-bold hover:bg-orange-50 transition">
                    <span class="material-symbols-outlined" style="font-size:18px">login</span>
                    Đăng nhập
                </a>
            }
        </div>
    </aside>

    <header class="sticky top-0 z-50 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-[1440px] mx-auto px-4 h-16 flex items-center gap-3">

        @* Nhóm Logo + Menu Trigger *@
        <div class="flex items-center gap-2 flex-shrink-0">
            <button id="mega-menu-btn"
                    class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                    aria-label="Mở menu danh mục">
                <span class="material-symbols-outlined text-2xl text-slate-600 dark:text-slate-300">menu</span>
            </button>
            <a asp-controller="RoomPosts" asp-action="Index" class="text-primary text-2xl font-bold tracking-tight">RoomHub</a>
        </div>

        @* Location Picker *@
        <div class="relative hidden md:block flex-shrink-0">
            <button id="location-btn"
                    class="flex items-center gap-1.5 px-3 py-1.5 border border-primary/40 bg-orange-50/60 dark:bg-orange-900/10 rounded-full text-sm font-medium whitespace-nowrap hover:bg-orange-100/80 transition-colors">
                <span class="material-symbols-outlined text-primary" style="font-size:18px">location_on</span>
                <span id="location-label">Toàn quốc</span>
                <span class="material-symbols-outlined text-slate-400" style="font-size:16px">expand_more</span>
            </button>
            <input type="hidden" id="location-hidden-input" name="province" value="" />

            @* Location Dropdown Panel *@
            <div id="location-dropdown"
                 class="absolute left-0 top-[calc(100%+6px)] w-72 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-100 dark:border-slate-700 z-[200] opacity-0 invisible scale-95 pointer-events-none transition-all duration-200 origin-top-left">
                <div class="p-3 border-b border-slate-100 dark:border-slate-700">
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" style="font-size:18px">search</span>
                        <input id="location-search-input" type="text"
                               placeholder="Tìm tỉnh/thành phố..."
                               class="w-full pl-9 pr-3 py-2 text-sm bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50" />
                    </div>
                </div>
                <div class="p-2 max-h-72 overflow-y-auto space-y-0.5 custom-scrollbar">
                    <button data-province="" class="w-full text-left px-3 py-2 text-sm rounded-lg font-semibold text-primary hover:bg-orange-50 dark:hover:bg-orange-900/20 transition-colors">
                        🌐 Toàn quốc
                    </button>
                    <div class="h-px bg-slate-100 dark:bg-slate-700 my-1"></div>
                    @{
                        var provinces = new[]
                        {
                            "An Giang","Bà Rịa - Vũng Tàu","Bắc Giang","Bắc Kạn","Bạc Liêu",
                            "Bắc Ninh","Bến Tre","Bình Định","Bình Dương","Bình Phước",
                            "Bình Thuận","Cà Mau","Cần Thơ","Cao Bằng","Đà Nẵng",
                            "Đắk Lắk","Đắk Nông","Điện Biên","Đồng Nai","Đồng Tháp",
                            "Gia Lai","Hà Giang","Hà Nam","Hà Nội","Hà Tĩnh",
                            "Hải Dương","Hải Phòng","Hậu Giang","Hòa Bình","Hưng Yên",
                            "Khánh Hòa","Kiên Giang","Kon Tum","Lai Châu","Lâm Đồng",
                            "Lạng Sơn","Lào Cai","Long An","Nam Định","Nghệ An",
                            "Ninh Bình","Ninh Thuận","Phú Thọ","Phú Yên","Quảng Bình",
                            "Quảng Nam","Quảng Ngãi","Quảng Ninh","Quảng Trị","Sóc Trăng",
                            "Sơn La","Tây Ninh","Thái Bình","Thái Nguyên","Thanh Hóa",
                            "Thừa Thiên Huế","Tiền Giang","TP. Hồ Chí Minh","Trà Vinh","Tuyên Quang",
                            "Vĩnh Long","Vĩnh Phúc","Yên Bái"
                        };
                    }
                    @foreach (var p in provinces)
                    {
                        <button data-province="@p" class="w-full text-left px-3 py-2 text-sm rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors">
                            @p
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Search Bar *@
        <form id="header-search-form"
              asp-controller="RoomPosts" asp-action="Index"
              method="get"
              class="flex-1 max-w-2xl relative">
            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                <span class="material-symbols-outlined text-slate-400" style="font-size:20px">search</span>
            </div>
            <input id="header-search-input"
                   name="q"
                   type="text"
                   value="@Context.Request.Query["q"]"
                   autocomplete="off"
                   class="w-full pl-11 pr-14 py-2.5 bg-slate-100 dark:bg-slate-800 border border-transparent rounded-full text-sm focus:outline-none focus:border-transparent focus:ring-2 focus:ring-primary/60 focus:bg-white dark:focus:bg-slate-700 transition-all placeholder:text-slate-400"
                   placeholder="Tìm kiếm phòng trọ, căn hộ, địa điểm..." />
            @* province hidden sync from dropdown *@
            <input type="hidden" name="province" id="search-province-sync" value="@Context.Request.Query["province"]" />
            <button type="submit"
                    class="absolute right-1.5 top-1/2 -translate-y-1/2 w-9 h-9 bg-primary text-white rounded-full flex items-center justify-center hover:bg-orange-600 active:scale-95 transition">
                <span class="material-symbols-outlined" style="font-size:18px">search</span>
            </button>
        </form>

        <div class="flex items-center gap-2 lg:gap-4">
            <div class="flex items-center gap-1 md:gap-3 px-2 border-r border-slate-200">
                @if (User.Identity.IsAuthenticated && (User.IsInRole("Tenant") || User.IsInRole("PropertyOwner")))
                {
                    <a asp-controller="Favorite" asp-action="Index" class="p-2 text-slate-700 hover:text-red-500 transition" title="Danh sách yêu thích">
                        <span class="material-symbols-outlined text-2xl">favorite</span>
                    </a>
                }
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Chat" asp-action="Index" class="p-2 text-slate-700 hover:text-primary transition" title="Tin nhắn">
                        <span class="material-symbols-outlined text-2xl">chat</span>
                    </a>
                }
                <div class="relative inline-block text-left" id="notification-wrapper">
                    <button id="nav-notification-bell" class="relative p-2 text-slate-700 hover:bg-slate-100 rounded-full transition-all focus:outline-none">
                        <span class="material-symbols-outlined text-2xl">notifications</span>
                        <!-- Nơi hiển thị Badge số lượng -->
                        <div id="notification-badge" class="hidden absolute top-1 right-1 w-4 h-4 bg-red-600 text-[10px] font-bold text-white flex items-center justify-center rounded-full border border-white">0</div>
                    </button>

                    <!-- Dropdown Panel (Facebook style) -->
                    <div id="notification-dropdown" class="hidden absolute right-0 mt-3 w-[360px] bg-white rounded-xl shadow-[0_10px_40px_rgba(0,0,0,0.12)] border border-gray-100 z-[9999] overflow-hidden origin-top-right transition-all">
                        <div class="p-4 border-b border-gray-50 flex justify-between items-center bg-white sticky top-0">
                            <h3 class="text-lg font-extrabold text-gray-900">Thông báo</h3>
                            <button onclick="markAllNotificationsAsRead()" class="text-xs font-bold text-blue-600 hover:bg-blue-50 px-2 py-1 rounded">Đánh dấu đã đọc</button>
                        </div>
                        <div id="notification-list" class="max-h-[420px] overflow-y-auto overflow-x-hidden custom-scrollbar divide-y divide-gray-50">
                            <!-- Template mẫu loading -->
                            <div class="p-8 text-center text-gray-400">
                                <span class="material-symbols-outlined animate-spin text-2xl">sync</span>
                                <p class="text-xs mt-1">Đang tải...</p>
                            </div>
                        </div>
                        <div class="p-3 border-t border-gray-50 text-center bg-gray-50/30">
                            <a href="#" class="text-xs font-bold text-blue-600 hover:underline">Xem tất cả thông báo</a>
                        </div>
                    </div>
                </div>
            </div>

            @* NÚT ĐĂNG TIN: chỉ hiện với Owner/Admin *@
            @if (User.Identity.IsAuthenticated && !User.IsInRole("Tenant"))
            {
                <a asp-controller="RoomPosts" asp-action="Create"
                   class="hidden sm:inline-flex items-center gap-1.5 bg-primary text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm hover:bg-orange-600 transition whitespace-nowrap">
                    <span class="material-symbols-outlined" style="font-size:16px">add</span>
                    Đăng tin
                </a>
            }

            @* AVATAR / LOGIN *@
            @if (User.Identity.IsAuthenticated)
            {
                <div class="relative group">
                    <button class="flex items-center gap-1 p-0.5 pl-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full cursor-pointer transition-colors" title="Hồ sơ cá nhân">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-orange-400 flex items-center justify-center text-white text-sm font-bold shadow-sm">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <span class="material-symbols-outlined text-slate-400 text-base transition-transform duration-200 group-hover:rotate-180">expand_more</span>
                    </button>

                    <div class="absolute right-0 top-full mt-2 w-56 bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-100 dark:border-slate-700 overflow-hidden opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                        <div class="p-3 border-b border-slate-100 dark:border-slate-700 bg-gradient-to-r from-orange-50 to-white dark:from-slate-800 dark:to-slate-800">
                            <p class="text-sm font-bold text-slate-800 dark:text-white truncate">@User.Identity.Name</p>
                            <p class="text-xs text-slate-500 mt-0.5">
                                @(User.IsInRole("PropertyOwner") ? "Property Owner" : (User.IsInRole("Tenant") ? "Tenant" : "Administrator"))
                            </p>
                        </div>
                        
                        @* KHOẢNG Div MENU CHÍNH - ĐÃ FIX CHUẨN HTML *@
                        <div class="p-1.5">
                            <a href="/Profile/Index" class="flex items-center gap-2 px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-primary rounded-lg transition-colors">
                                <span class="material-symbols-outlined text-[20px]">person</span>
                                Trang cá nhân
                            </a>

                            @if (!User.IsInRole("Tenant"))
                            {
                                <a asp-controller="RoomPosts" asp-action="MyPosts" class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 hover:text-primary rounded-xl transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">list_alt</span>
                                    Quản lý bài đăng
                                </a>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 hover:text-primary rounded-xl transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">dashboard</span>
                                    Quản lý hệ thống
                                </a>
                            }

                            @if (User.IsInRole("PropertyOwner"))
                            {
                                <li>
                                    <a href="@Url.Action("Index", "Buildings")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors">
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-[20px]">domain</span>
                                            Quản lý Tòa nhà
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Index", "Billing")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-[20px]">receipt_long</span> Chốt số & Tính tiền
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Invoices", "Billing")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-green-50 hover:text-green-600 transition-colors">
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-[20px]">payments</span> Quản lý Hóa đơn
                                        </div>
                                    </a>
                                </li>
                                <li><hr class="border-gray-100 my-1"></li>
                            }
                            @if (User.IsInRole("Tenant"))
                {

                    <li>
                        <a href="@Url.Action("MyRoom", "TenantBilling")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[20px]">meeting_room</span>
                                Phòng đang ở
                            </div>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("MyInvoices", "TenantBilling")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                                Hóa đơn của tôi
                            </div>
                        </a>
                    </li>
                }
                        </div>

                        <div class="p-1.5 border-t border-slate-100 dark:border-slate-700">
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl transition-colors text-left">
                                    <span class="material-symbols-outlined text-[20px]">logout</span>
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login"
                   class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-2 rounded-lg border border-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition cursor-pointer text-slate-700 dark:text-slate-200">
                    <span class="material-symbols-outlined" style="font-size:18px">login</span>
                    Đăng nhập
                </a>
            }
        </div>
    </div>
</header>

    @RenderBody()

    <footer class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 pt-16 mt-12">
        <div class="max-w-[1200px] mx-auto px-4 pb-12">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
                <!-- Branding & Contact -->
                <div class="space-y-6 lg:col-span-1">
                    <a href="/" class="block">
                        <span class="text-3xl font-black bg-gradient-to-r from-primary to-orange-500 bg-clip-text text-transparent">RoomHub</span>
                    </a>
                    <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                        Nền tảng tìm kiếm và cho thuê phòng trọ, căn hộ, nhà nguyên căn hàng đầu Việt Nam. Nhanh chóng, an toàn và tiện lợi.
                    </p>
                    <div class="space-y-3 pt-2">
                        <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-xl">location_on</span>
                            <span>Tòa nhà UOA, Số 6 Tân Trào, Quận 7, TP.HCM</span>
                        </p>
                        <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-xl">call</span>
                            <span class="font-semibold">1900 1234</span>
                        </p>
                        <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-xl">mail</span>
                            <span>contact@roomhub.vn</span>
                        </p>
                    </div>
                </div>

                <!-- Về RoomHub -->
                <div class="space-y-6">
                    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Về RoomHub</h4>
