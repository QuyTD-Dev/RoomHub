@using System.Security.Claims
@model Application.DTOs.RoomPosts.PaginatedList<Application.DTOs.RoomPosts.RoomListViewModel>
@{
    ViewData["Title"] = "Property Marketplace";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = User.IsInRole("PropertyOwner");
    var isSearching = (bool)(ViewBag.isSearching ?? false);
    var searchQuery = (string?)ViewBag.searchQuery;
    var province = (string?)ViewBag.province;
    var currentRoomType = (Domain.Enums.RoomType?)ViewBag.roomType;
    var currentMinPrice = (decimal?)ViewBag.minPrice;
    var currentMaxPrice = (decimal?)ViewBag.maxPrice;
    var currentDistrict = (string?)ViewBag.district;
    var currentSortBy = (string?)ViewBag.sortBy ?? "newest";

    string BuildFilterUrl(string? q = null, string? prov = null, string? rt = null, string? minP = null, string? maxP = null, string? dist = null, string? sort = null, bool clearRoomType = false, bool clearPrice = false, bool clearProvince = false, bool clearDistrict = false)
    {
        var qs = new List<string>();
        var qVal = q ?? searchQuery;
        if (!string.IsNullOrWhiteSpace(qVal)) qs.Add($"q={Uri.EscapeDataString(qVal)}");
        if (!clearProvince)
        {
            var provVal = prov ?? province;
            if (!string.IsNullOrWhiteSpace(provVal)) qs.Add($"province={Uri.EscapeDataString(provVal)}");
        }
        if (!clearRoomType)
        {
            var rtVal = rt ?? currentRoomType?.ToString();
            if (!string.IsNullOrWhiteSpace(rtVal)) qs.Add($"roomType={Uri.EscapeDataString(rtVal)}");
        }
        if (!clearPrice)
        {
            var minVal = minP ?? currentMinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (!string.IsNullOrWhiteSpace(minVal)) qs.Add($"minPrice={minVal}");
            var maxVal = maxP ?? currentMaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (!string.IsNullOrWhiteSpace(maxVal)) qs.Add($"maxPrice={maxVal}");
        }
        if (!clearDistrict)
        {
            var distVal = dist ?? currentDistrict;
            if (!string.IsNullOrWhiteSpace(distVal)) qs.Add($"district={Uri.EscapeDataString(distVal)}");
        }
        var sortVal = sort ?? currentSortBy;
        if (!string.IsNullOrWhiteSpace(sortVal) && sortVal != "newest") qs.Add($"sortBy={sortVal}");
        return "/RoomPosts" + (qs.Any() ? "?" + string.Join("&", qs) : "");
    }

    var sortLabel = currentSortBy switch
    {
        "price_asc" => "Giá tăng dần",
        "price_desc" => "Giá giảm dần",
        "area_asc" => "Diện tích tăng",
        "area_desc" => "Diện tích giảm",
        _ => "Mới nhất"
    };

    var roomTypeIcons = new[] {
        (Domain.Enums.RoomType.Apartment, "apartment", "Căn hộ"),
        (Domain.Enums.RoomType.Single, "meeting_room", "Phòng đơn"),
        (Domain.Enums.RoomType.Double, "king_bed", "Phòng đôi"),
        (Domain.Enums.RoomType.Studio, "weekend", "Studio"),
        (Domain.Enums.RoomType.WholeHouse, "home", "Nhà nguyên căn"),
        (Domain.Enums.RoomType.Shared, "group", "Phòng ghép"),
        (Domain.Enums.RoomType.Duplex, "stairs", "Duplex"),
        (Domain.Enums.RoomType.Other, "more_horiz", "Khác")
    };

    var regions = new[] { "Hồ Chí Minh", "Hà Nội", "Đà Nẵng", "Bình Dương", "Thừa Thiên Huế", "Cần Thơ", "Hải Phòng" };
}
<main class="max-w-[1400px] mx-auto px-4 py-6 pb-24">

    @if (isSearching)
    {
        <div class="mb-6 flex items-center justify-between bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl px-5 py-4 shadow-sm">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="material-symbols-outlined text-orange-500" style="font-size:24px">search</span>
                <span class="text-base font-medium text-slate-700 dark:text-slate-300">
                    Kết quả tìm kiếm
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <span> cho <strong class="text-orange-600">"@searchQuery"</strong></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(province))
                    {
                        <span> tại <strong class="text-orange-600">@province</strong></span>
                    }
                    @if (currentRoomType.HasValue)
                    {
                        <span> — <strong class="text-orange-600">@currentRoomType</strong></span>
                    }
                    @if (currentMinPrice.HasValue || currentMaxPrice.HasValue)
                    {
                        <span>
                            — Giá:
                            @if (currentMinPrice.HasValue)
                            {
                                <span>từ <strong>@currentMinPrice?.ToString("N0")đ</strong></span>
                            }
                            @if (currentMaxPrice.HasValue)
                            {
                                <span>đến <strong>@currentMaxPrice?.ToString("N0")đ</strong></span>
                            }
                        </span>
                    }
                    <span class="text-slate-500 bg-white dark:bg-slate-800 px-2 py-0.5 rounded-md ml-2 text-sm border border-slate-200">Tìm thấy @Model.TotalItems phòng</span>
                </span>
            </div>
            <a href="/RoomPosts" class="text-sm font-semibold text-slate-500 hover:text-red-500 flex items-center gap-1 whitespace-nowrap bg-white dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 transition-colors">
                <span class="material-symbols-outlined" style="font-size:18px">close</span> Xoá bộ lọc
            </a>
        </div>
    }

    @* ===== FILTER BAR ===== *@
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 mb-8">
        @* Row 1: Filter buttons *@
        <div class="flex items-center gap-3 overflow-x-auto pb-3 hide-scrollbar">
            <button id="btnAdvancedFilter"
                    class="flex items-center gap-2 px-5 py-2.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-semibold whitespace-nowrap hover:border-orange-500 hover:text-orange-500 hover:bg-orange-50 transition-all">
                <span class="material-symbols-outlined text-lg">tune</span> Bộ lọc chi tiết
            </button>

            @* Loại phòng *@
            <div class="relative" id="roomTypeDropdown">
                <button data-dropdown="roomTypeMenu"
                        class="flex items-center gap-1 px-4 py-2.5 rounded-xl text-sm font-medium whitespace-nowrap transition-all @(currentRoomType.HasValue ? "bg-orange-500 text-white shadow-md shadow-orange-500/30" : "bg-slate-100 dark:bg-slate-800 border border-transparent hover:border-orange-500 hover:text-orange-500")">
                    Loại phòng @(currentRoomType.HasValue ? $"({currentRoomType})" : "")
                    <span class="material-symbols-outlined text-sm ml-1">expand_more</span>
                </button>
                <div id="roomTypeMenu" class="filter-dropdown hidden fixed bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-[9999] min-w-[220px] py-2 overflow-hidden">
                    @foreach (Domain.Enums.RoomType rt in Enum.GetValues(typeof(Domain.Enums.RoomType)))
                    {
                        var isActive = currentRoomType.HasValue && currentRoomType.Value == rt;
                        var displayAttr = rt.GetType().GetField(rt.ToString())?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false);
                        var displayName = (displayAttr != null && displayAttr.Length > 0) ? ((System.ComponentModel.DataAnnotations.DisplayAttribute)displayAttr[0]).Name : rt.ToString();
                        <a href="@BuildFilterUrl(rt: rt.ToString())"
                               class="block px-5 py-3 text-sm hover:bg-orange-50 dark:hover:bg-slate-700 transition-colors @(isActive ? "text-orange-600 font-bold bg-orange-50" : "text-slate-700 dark:text-slate-300")">
                            @displayName
                        </a>
                    }
                    @if (currentRoomType.HasValue)
                    {
                        <div class="border-t border-slate-100 dark:border-slate-700 mt-2">
                            <a href="@BuildFilterUrl(clearRoomType: true)" class="block px-5 py-3 text-sm text-red-500 hover:bg-red-50 font-bold text-center">
                                Bỏ lọc loại phòng
                            </a>
                        </div>
                    }
                </div>
            </div>

            @* Khoảng giá *@
            <div class="relative" id="priceDropdown">
                <button data-dropdown="priceMenu"
                        class="flex items-center gap-1 px-4 py-2.5 rounded-xl text-sm font-medium whitespace-nowrap transition-all @(currentMinPrice.HasValue || currentMaxPrice.HasValue ? "bg-orange-500 text-white shadow-md shadow-orange-500/30" : "bg-slate-100 dark:bg-slate-800 border border-transparent hover:border-orange-500 hover:text-orange-500")">
                    Khoảng giá @(currentMinPrice.HasValue || currentMaxPrice.HasValue ? "✓" : "")
                    <span class="material-symbols-outlined text-sm ml-1">expand_more</span>
                </button>
                <div id="priceMenu" class="filter-dropdown hidden fixed bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-[9999] min-w-[220px] py-2 overflow-hidden">
                    <a href="@BuildFilterUrl(maxP: "3000000", clearPrice: true)" class="block px-5 py-3 text-sm text-slate-700 hover:bg-orange-50 transition-colors">Dưới 3 triệu</a>
                    <a href="@BuildFilterUrl(minP: "3000000", maxP: "5000000")" class="block px-5 py-3 text-sm text-slate-700 hover:bg-orange-50 transition-colors">3 - 5 triệu</a>
                    <a href="@BuildFilterUrl(minP: "5000000", maxP: "10000000")" class="block px-5 py-3 text-sm text-slate-700 hover:bg-orange-50 transition-colors">5 - 10 triệu</a>
                    <a href="@BuildFilterUrl(minP: "10000000", maxP: "20000000")" class="block px-5 py-3 text-sm text-slate-700 hover:bg-orange-50 transition-colors">10 - 20 triệu</a>
                    <a href="@BuildFilterUrl(minP: "20000000")" class="block px-5 py-3 text-sm text-slate-700 hover:bg-orange-50 transition-colors">Trên 20 triệu</a>
                    @if (currentMinPrice.HasValue || currentMaxPrice.HasValue)
                    {
                        <div class="border-t border-slate-100 mt-2">
                            <a href="@BuildFilterUrl(clearPrice: true)" class="block px-5 py-3 text-sm text-red-500 hover:bg-red-50 font-bold text-center">
                                Bỏ lọc giá
                            </a>
                        </div>
                    }
                </div>
            </div>

            @* Sắp xếp *@
            <div class="relative" id="sortDropdown">
                <button data-dropdown="sortMenu"
                        class="flex items-center gap-1 px-4 py-2.5 rounded-xl text-sm font-medium whitespace-nowrap transition-all @(currentSortBy != "newest" ? "bg-orange-500 text-white shadow-md shadow-orange-500/30" : "bg-slate-100 dark:bg-slate-800 border border-transparent hover:border-orange-500 hover:text-orange-500")">
                    <span class="material-symbols-outlined text-[16px]">sort</span> @sortLabel
                    <span class="material-symbols-outlined text-sm ml-1">expand_more</span>
                </button>
                <div id="sortMenu" class="filter-dropdown hidden fixed bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-[9999] min-w-[220px] py-2 overflow-hidden">
                    @{
                        var sortOptions = new[] {
                                ("newest", "Mới nhất", "schedule"),
                                ("price_asc", "Giá tăng dần", "trending_up"),
                                ("price_desc", "Giá giảm dần", "trending_down"),
                                ("area_asc", "Diện tích tăng", "open_in_full"),
                                ("area_desc", "Diện tích giảm", "close_fullscreen")
                            };
                    }
                    @foreach (var (val, label, icon) in sortOptions)
                    {
                        var isActive = currentSortBy == val;
                        <a href="@BuildFilterUrl(sort: val)"
                               class="flex items-center gap-3 px-5 py-3 text-sm hover:bg-orange-50 transition-colors @(isActive ? "text-orange-600 font-bold bg-orange-50" : "text-slate-700 dark:text-slate-300")">
                            <span class="material-symbols-outlined text-[18px]">@icon</span> @label
                        </a>
                    }
                </div>
            </div>

            <div class="h-8 w-px bg-slate-200 dark:bg-slate-700 mx-2"></div>
            <a href="/RoomPosts" class="text-slate-400 text-sm font-bold hover:text-red-500 whitespace-nowrap px-2 transition-colors">Đặt lại tất cả</a>
        </div>

        @* Advanced filter panel *@
        <div id="advancedFilterPanel" class="hidden border-t border-slate-100 dark:border-slate-800 pt-5 mt-2">
            <form method="get" action="/RoomPosts/Index" class="flex flex-wrap items-end gap-5">
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <input type="hidden" name="q" value="@searchQuery" />
                }
                @if (currentRoomType.HasValue)
                {
                    <input type="hidden" name="roomType" value="@currentRoomType" />
                }
                @if (currentSortBy != "newest")
                {
                    <input type="hidden" name="sortBy" value="@currentSortBy" />
                }
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Tỉnh/Thành phố</label>
                    <input type="text" name="province" value="@province" placeholder="Ví dụ: Hồ Chí Minh"
                           class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm w-48 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none transition-all bg-gray-50 focus:bg-white" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Quận/Huyện</label>
                    <input type="text" name="district" value="@currentDistrict" placeholder="Ví dụ: Quận 1"
                           class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm w-48 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none transition-all bg-gray-50 focus:bg-white" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Giá từ (VNĐ)</label>
                    <input type="number" name="minPrice" value="@currentMinPrice" placeholder="0"
                           class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm w-40 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none transition-all bg-gray-50 focus:bg-white" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Giá đến (VNĐ)</label>
                    <input type="number" name="maxPrice" value="@currentMaxPrice" placeholder="Không giới hạn"
                           class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm w-40 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none transition-all bg-gray-50 focus:bg-white" />
                </div>
                <button type="submit" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 transition-colors flex items-center gap-2 shadow-md">
                    <span class="material-symbols-outlined text-[18px]">search</span> Áp dụng
                </button>
            </form>
        </div>

        @* Row 2: Region quick filters *@
        <div class="flex items-center gap-2 py-4 border-t border-slate-100 dark:border-slate-800 overflow-x-auto hide-scrollbar mt-3">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider mr-3 flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">location_on</span> Khu vực:</span>
            @foreach (var name in regions)
            {
                var isActive = !string.IsNullOrWhiteSpace(province) && province.Contains(name, StringComparison.OrdinalIgnoreCase);
                if (isActive)
                {
                    <a href="@BuildFilterUrl(clearProvince: true)"
                           class="px-4 py-1.5 border border-orange-500 rounded-full text-sm whitespace-nowrap bg-orange-50 text-orange-600 font-bold transition-all flex items-center gap-1.5 shadow-sm">
                        @name <span class="material-symbols-outlined text-[14px]">close</span>
                    </a>
                }
                else
                {
                    <a href="@BuildFilterUrl(prov: name)"
                           class="px-4 py-1.5 border border-slate-200 bg-white rounded-full text-sm whitespace-nowrap text-slate-600 hover:border-orange-500 hover:text-orange-500 transition-all">
                        @name
                    </a>
                }
            }
        </div>

        @* Row 3: Room type icons *@
        <div class="flex items-center gap-8 pt-5 pb-2 border-t border-slate-100 dark:border-slate-800 justify-start overflow-x-auto hide-scrollbar">
            @foreach (var (rt, icon, label) in roomTypeIcons)
            {
                var isActive = currentRoomType.HasValue && currentRoomType.Value == rt;
                var url = isActive ? BuildFilterUrl(clearRoomType: true) : BuildFilterUrl(rt: rt.ToString());
                <a href="@url" class="flex flex-col items-center gap-2.5 min-w-[72px] group relative">
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center transition-all duration-300 @(isActive ? "bg-orange-500 text-white shadow-lg shadow-orange-500/30 -translate-y-1" : "bg-slate-50 text-slate-500 group-hover:bg-orange-50 group-hover:text-orange-500 group-hover:-translate-y-1")">
                        <span class="material-symbols-outlined text-2xl">@icon</span>
                    </div>
                    <span class="text-xs font-bold transition-colors @(isActive ? "text-orange-600" : "text-slate-500 group-hover:text-orange-500")">@label</span>
                    @if (isActive)
                    {
                        <div class="absolute -bottom-2 w-1.5 h-1.5 rounded-full bg-orange-500"></div>
                    }
                </a>
            }
        </div>
    </div>

    @* ===== GRID HIỂN THỊ DANH SÁCH PHÒNG ===== *@
    <div>
        @if (Model != null && Model.Items.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var item in Model.Items)
                {
                    bool isMyPost = isOwner && item.LandlordId == currentUserId;

                    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-800 overflow-hidden group cursor-pointer hover:shadow-xl transition-all duration-300 flex flex-col">
                        <div class="h-64 relative overflow-hidden bg-slate-100">
                            <img alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="@(string.IsNullOrEmpty(item.MainPhotoUrl) ? "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&q=80" : item.MainPhotoUrl)" />
                                
                            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                            @if (!isMyPost && User.Identity.IsAuthenticated)
                            {
                                <button class="btn-toggle-favorite absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-white/90 backdrop-blur shadow hover:scale-110 hover:bg-white transition-all flex items-center justify-center"
                                        data-room-id="@item.Id">
                                    <span class="material-symbols-outlined text-[20px] transition-colors duration-300"
                                          style="@(item.IsFavorite ? "font-variation-settings: 'FILL' 1; color: #ef4444;" : "font-variation-settings: 'FILL' 0; color: #94a3b8;")">
                                        favorite
                                    </span>
                                </button>
                            }

                            @{
                                var statusText = item.Status switch
                                {
                                    Domain.Enums.RoomStatus.Active => "Đang hoạt động",
                                    Domain.Enums.RoomStatus.Available => "Sẵn sàng",
                                    Domain.Enums.RoomStatus.Deposited => "Đã cọc",
                                    Domain.Enums.RoomStatus.Occupied => "Đã thuê",
                                    Domain.Enums.RoomStatus.Maintenance => "Bảo trì",
                                    Domain.Enums.RoomStatus.UnderMaintenance => "Đang bảo trì",
                                    Domain.Enums.RoomStatus.Hidden => "Đã ẩn",
                                    _ => item.Status.ToString()
                                };
                                var badgeClass = item.Status switch
                                {
                                    Domain.Enums.RoomStatus.Active => "bg-emerald-500",
                                    Domain.Enums.RoomStatus.Hidden => "bg-slate-500",
                                    Domain.Enums.RoomStatus.Available => "bg-blue-500",
                                    Domain.Enums.RoomStatus.Occupied => "bg-orange-500",
                                    _ => "bg-yellow-500"
                                };
                            }
                            <div class="absolute top-4 left-4 @badgeClass text-white text-[11px] px-3 py-1.5 rounded-full font-bold uppercase tracking-wider shadow-sm flex items-center gap-1">
                                <div class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></div>
                                @statusText
                            </div>
                                
                            <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-xl shadow-lg">
                                <p class="text-orange-600 font-black text-lg">@(item.BasePrice.ToString("N0") + "đ")<span class="text-xs text-slate-500 font-medium">/tháng</span></p>
                            </div>
                        </div>
                            
                        <div class="p-5 flex flex-col flex-1 relative">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-[11px] font-bold text-orange-500 bg-orange-50 px-2 py-0.5 rounded-md uppercase tracking-wider">Phòng @item.RoomNumber</span>
                                <span class="text-[11px] font-semibold text-slate-400 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">schedule</span> @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            </div>
                                
                            <h3 class="font-bold text-slate-900 text-lg leading-snug mb-3 line-clamp-2 group-hover:text-orange-600 transition-colors">
                                <a asp-action="Details" asp-route-id="@item.Id" class="before:absolute before:inset-0">@item.Title</a>
                            </h3>
                                
                            <div class="flex items-center gap-4 mt-auto mb-4 text-sm font-medium text-slate-500">
                                <div class="flex items-center gap-1.5 bg-slate-50 px-2.5 py-1.5 rounded-lg border border-slate-100">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">straighten</span> @(item.SurfaceArea?.ToString("0.##") ?? "--") m²
                                </div>
                                <div class="flex items-center gap-1.5 bg-slate-50 px-2.5 py-1.5 rounded-lg border border-slate-100">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">star</span> @item.AmenityCount T.Ích
                                </div>
                            </div>
                                
                            <div class="pt-4 border-t border-slate-100 flex items-start gap-1.5 text-sm text-slate-600">
                                <span class="material-symbols-outlined text-[18px] text-slate-400 mt-0.5 shrink-0">location_on</span>
                                <span class="line-clamp-1">@item.Address</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            // EMPTY STATE
            <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-dashed border-slate-300 dark:border-slate-800 p-16 text-center max-w-2xl mx-auto">
                @if (isSearching)
                {
                    <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6">
                        <span class="material-symbols-outlined text-5xl text-slate-300">search_off</span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200 mb-2">Không tìm thấy phòng phù hợp</h3>
                    <p class="text-slate-500 mb-8">
                        Không có phòng nào khớp với các tiêu chí tìm kiếm hiện tại của bạn. Vui lòng thử thay đổi khoảng giá, khu vực hoặc loại phòng.
                    </p>
